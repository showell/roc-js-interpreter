-- budget: steps=20000000 arena_bytes=400000000 read_bytes=100000000 output_bytes=200000
-- This builds the JavaScript book, Compiling JavaScript in Roc, with the
-- book builder (roc-apps' book_builder/), into the dev
-- channel's /js-book/:
--
--   cd <roc-js-interpreter checkout> && shale js-book/book.shale
--
-- The book builder is roc-apps', in the roc-apps checkout beside this one
-- (ROC_APPS), and its tools run with that checkout as their root, so they
-- name this checkout's files through its mount (HERE): this script runs from
-- the checkout at HERE alone, and stops elsewhere. The book is the app
-- app/main.roc on the book platform, which reads this checkout from its root
-- and prints every page. First every commit the manuscript cites is held to
-- resolve (check_citations, below). Its pre-step draws each
-- ```dot fence of the manuscript with Graphviz
-- (book_builder/tools/draw_diagrams.shale) into build/prepared/, as
-- diagram-N.dot and diagram-N.svg, where the app reads them. It also writes
-- the appendix's listings there from js/'s folders (write_listings, below),
-- so a new sample or test is in the book at its next build, and each
-- console sample's output, as js-vm's dev build prints it then. The pictures
-- the manuscript's ```shot fences name come from js-book/shots/ (taken by
-- js-book/canvas_shots.mjs, checked in): each named one must be there, and
-- each one there must be named, and they go beside the pages.
--
-- Then the book builder's tools/build_book.shale runs the app's expects, held
-- to exactly APP_TESTS, builds the app into book_builder/zig-out/js-book, on
-- Roc's dev backend, and runs the program on the checkout's root, which
-- writes the pages, or stops on a gate. The pages go to build/book/ with the
-- builder's stylesheet, and are staged in the channel's /js-book.staging/.
-- The builder's tools/book_check.mjs drives them there in a real browser and
-- leaves a shot of each page in build/shots/. Then the book builder's
-- tools/move_stage.shale puts the stage in the place of /js-book/. A failure
-- at any step stops the run before the move, so the channel's book is left
-- as it was.
const BOOK = "js-book"
const SOURCE = "js-book/book.md"
const PREPARED = "js-book/build/prepared"
const OUT = "js-book/build/book"
const REPORT = "js-book/build/report.txt"
const SHOTS = "js-book/build/shots"
const PICTURES = "js-book/shots"
const GITHUB = "https://github.com/showell/roc-js-interpreter/blob/master/"
const VM_WANT = "js-vm: each console sample's output for the appendix"
const NEXT = "build:roc-apps/next"
const DEST_NAME = "js-book"
const STAGED_NAME = "js-book.staging"
const ROC_APPS = "repos:roc-apps"
const HERE = "repos:roc-js-interpreter"
const DRAW = "book_builder/tools/draw_diagrams.shale"
const MOVE = "book_builder/tools/move_stage.shale"
const CHECKER = "book_builder/tools/book_check.mjs"
const BUILD = "book_builder/tools/build_book.shale"
const APP_TESTS = 7
const DOT_WANT = "graphviz: a book's diagrams, drawn at build time"
const CHECK_WANT = "script: book_check.mjs drives the staged pages in headless Chromium"

-- The playground's order of its samples, as js/web/js_page.js lists them:
-- the first canvas sample, the featured console samples, the other canvas
-- samples, then the console samples of js/console/.
const PAGE_ORDER = "  CANVAS_SAMPLES[0],\n  ...FEATURED_SAMPLES.map(asConsole),\n  ...CANVAS_SAMPLES.slice(1),\n  ...CONSOLE_SAMPLES.map(asConsole),\n];"

-- The featured console samples, as js/build.shale's FEATURED names them.
function featured_samples()
  local found = {}
  for g in grep("js/build.shale", "{title = \"") do
    local m = re_find(g.text, [=[^  \{title = "([^"]+)", file = "([^"]+)"\},$]=])
    if m == nil then fail("book: js/build.shale:" .. g.line .. " is a featured sample this script can't read: " .. g.text) end
    push(found, {title = m.groups[1], file = m.groups[2]})
  end
  if #found == 0 then fail("book: js/build.shale names no featured samples") end
  return found
end

-- The section of one sample: its title as the page shows it, and its file.
function sample_section(title, file)
  return "### " .. title .. "\n\n{{file " .. file .. "}}\n"
end

-- The sections of a folder's samples, in their files' order, each titled by
-- its first line, `// <title>`.
function titled_sections(folder)
  local sections = {}
  for f in glob(folder .. "/*.js") do
    local first = lines(read(f))[1]
    if not starts_with(first, "// ") then fail("book: " .. f .. " has no first line `// <title>`") end
    push(sections, sample_section(sub(first, 4, #first), f))
  end
  return sections
end

-- A console sample's section, then what js-vm (`exe`) prints for it, its
-- exit code said when it isn't 0.
function printed_section(exe, file)
  local first = lines(read(file))[1]
  local r = run({exe, read(file)}, {timeout_ms = 30000, whole = 200000, want = VM_WANT})
  if r.ended ~= "exit" then fail("book: js-vm on " .. file .. " ended by " .. r.ended) end
  local said = "What js-vm prints"
  if r.code ~= 0 then said = said .. ", then exits " .. r.code end
  return sample_section(sub(first, 4, #first), file) .. "\n```text " .. said .. "\n" .. trim(r.out) .. "\n```\n"
end

-- Writes listing-samples.md, listing-corpus.md and listing-refused.md, the
-- lines the app puts in place of the manuscript's `{{listing NAME}}` lines:
-- every sample the playground offers, in the page's order, each titled by
-- its first line as js/build.shale titles it, each console sample followed
-- by what js-vm prints for it; then a table of the programs of js/tests/,
-- each linked to its file, and the refused programs of js/tests/refused/
-- with the message each must end with (its first line). Each sample is quoted
-- by the builder's own include, so the book quotes it as it stands.
function write_listings(exe)
  if not contains(read("js/web/js_page.js"), PAGE_ORDER) then fail("book: js/web/js_page.js no longer lists its samples in the order write_listings follows") end
  local canvas = titled_sections("js/canvas")
  local samples = {canvas[1]}
  for s in featured_samples() do push(samples, sample_section(s.title, s.file)) end
  for s in drop(canvas, 1) do push(samples, s) end
  for f in glob("js/console/*.js") do push(samples, printed_section(exe, f)) end
  create(PREPARED .. "/listing-samples.md", join(samples, "\n"))
  local corpus = {"| program | lines |", "|---|---|"}
  for f in glob("js/tests/*.js") do push(corpus, "| [" .. basename(f) .. "](" .. GITHUB .. f .. ") | " .. count_lines(f) .. " |") end
  create(PREPARED .. "/listing-corpus.md", join(corpus, "\n") .. "\n")
  local refused = {"```text The refused programs, each with its message"}
  local count = 0
  for f in glob("js/tests/refused/*.js") do
    local m = re_find(lines(read(f))[1], "^// refused: (.+)$")
    if m == nil then fail("book: " .. f .. " has no first line `// refused: <message>`") end
    push(refused, basename(f) .. "\n    " .. m.group)
    count = count + 1
  end
  push(refused, "```")
  create(PREPARED .. "/listing-refused.md", join(refused, "\n") .. "\n")
  print("book: the appendix lists " .. #samples .. " samples, " .. (#corpus - 2) .. " programs and " .. count .. " refused")
end

-- The names of the manuscript's ```shot fences.
function shots_named()
  local names = {}
  for m in re_find_all(read(SOURCE), "\n```shot ([a-z0-9-]+)\n") do push(names, m.group) end
  return names
end

-- Every picture the manuscript names, put in `out`'s shots/, after each is
-- held to js-book/shots/: a name with no file, or a file no fence names,
-- stops the build.
function pictures_placed(out)
  local named = shots_named()
  local wrong = {}
  for n in named do
    if not exists(PICTURES .. "/" .. n .. ".png") then push(wrong, n .. ": named by a ```shot fence, with no " .. PICTURES .. "/" .. n .. ".png") end
  end
  for f in glob(PICTURES .. "/*") do
    if not has_item(named, sub(basename(f), 1, #basename(f) - 4)) then push(wrong, f .. ": no ```shot fence names it") end
  end
  if #wrong > 0 then
    for w in wrong do print("  " .. w) end
    fail("book: the pictures and the manuscript disagree, so /" .. DEST_NAME .. "/ is left as it was")
  end
  mkdir(out .. "/shots")
  for n in named do copy(PICTURES .. "/" .. n .. ".png", out .. "/shots/" .. n .. ".png") end
  print("book: " .. #named .. " pictures of the playground")
  return nil
end

-- Every commit the manuscript cites resolves: a short hash in backticks is
-- a commit of this repository, and one written as a link to roc-apps'
-- commit (`[`h`](https://github.com/showell/roc-apps/commit/h)`, for work
-- that was never js/'s or js-book/'s) is a commit of the roc-apps checkout
-- beside this one. The history came here from roc-apps with new hashes, so
-- a hash copied from roc-apps' log is caught here, named.
function check_citations()
  local text = read(SOURCE)
  local here = {}
  local there = {}
  local wrong = {}
  local cited = 0
  for m in re_find_all(text, "\\[`([0-9a-f]{7,12})`\\]\\(https://github\\.com/showell/roc-apps/commit/([0-9a-f]{7,40})\\)") do
    if not starts_with(m.groups[2], m.groups[1]) then push(wrong, m.groups[1] .. " links to roc-apps' " .. m.groups[2]) end
    there[m.groups[1]] = true
  end
  for m in re_find_all(text, "`([0-9a-f]{7,12})`") do
    cited = cited + 1
    if not has_key(there, m.group) then here[m.group] = true end
  end
  for pair in {{list = keys(here), dir = real("."), where = "this repository"}, {list = keys(there), dir = real(ROC_APPS), where = "roc-apps"}} do
    for h in sort(pair.list) do
      local r = run({"git", "-C", pair.dir, "cat-file", "-e", h .. "^{commit}"}, {timeout_ms = 10000, whole = 2000})
      if r.code ~= 0 then push(wrong, h .. " is no commit of " .. pair.where) end
    end
  end
  if #wrong > 0 then
    for w in wrong do print("  " .. w) end
    fail("book: " .. #wrong .. " of the manuscript's cited commits don't resolve, so /" .. DEST_NAME .. "/ is left as it was")
  end
  print("book: " .. cited .. " citations of " .. (#keys(here) + #keys(there)) .. " commits resolve, " .. #keys(there) .. " of them roc-apps'")
  return nil
end

-- `to`, a real path, as a path relative to the real folder `from`.
function relative_path(from, to)
  local a = split(from, "/")
  local b = split(to, "/")
  local i = 1
  while i <= #a and i <= #b and a[i] == b[i] do i = i + 1 end
  local parts = {}
  for j = i, #a do push(parts, "..") end
  for j = i, #b do push(parts, b[j]) end
  return join(parts, "/")
end

function main()
  if not exists(HERE) or real(HERE) ~= real(".") then fail("book: run from the checkout at " .. HERE .. " (" .. (exists(HERE) and real(HERE) or "not there") .. "), which roc-apps' tools reach by that mount") end
  if not exists(ROC_APPS .. "/" .. BUILD) then fail("book: no " .. ROC_APPS .. "/" .. BUILD .. ": clone roc-apps beside this checkout") end
  check_citations()
  if exists(PREPARED) then remove_tree(PREPARED) end
  mkdir(PREPARED)
  write_listings(built_roc("book", "js/roc/JsVm.roc", "js-vm", "dev"))
  local drawn = must(run({"shale", "--root", ".", DRAW, "source=" .. HERE .. "/" .. SOURCE, "prepared=" .. HERE .. "/" .. PREPARED}, {cwd = ROC_APPS, timeout_ms = 120000, tail = 20, want = DOT_WANT}))
  for l in lines(drawn.out) do
    if starts_with(l, "draw_diagrams: ") then print("book: " .. sub(l, 16) .. " in " .. drawn.ms .. " ms") end
  end

  local app = relative_path(real(ROC_APPS .. "/book_builder"), real(BOOK .. "/app/main.roc"))
  local argv = {"shale", "--root", ".", BUILD, "book=" .. HERE .. "/" .. BOOK, "tests=" .. APP_TESTS, "name=js-book", "folder=" .. real("."), "out=" .. HERE .. "/" .. OUT, "report=" .. HERE .. "/" .. REPORT, "app=" .. app}
  local built = run(argv, {cwd = ROC_APPS, timeout_ms = 900000, tail = 60})
  local pages = 0
  for l in lines(built.out) do
    if starts_with(l, "build_book: ") then print("book: " .. sub(l, 13)) end
    local m = re_find(l, "^build_book: ([0-9]+) pages in ")
    if m ~= nil then pages = tonumber(m.groups[1]) end
  end
  if built.code ~= 0 then
    print(trim(built.out))
    fail("book: build_book.shale stopped, so /" .. DEST_NAME .. "/ is left as it was")
  end
  pictures_placed(OUT)
  local staging = NEXT .. "/" .. STAGED_NAME
  if exists(staging) then remove_tree(staging) end
  copy(OUT, staging)

  if exists(SHOTS) then remove_tree(SHOTS) end
  mkdir(SHOTS)
  local check_argv = {"nice", "-n", "19", "node", real(ROC_APPS .. "/" .. CHECKER), "http://127.0.0.1:9210/" .. STAGED_NAME .. "/", real(SHOTS)}
  local checked = run(check_argv, {timeout_ms = 600000, tail = 60, want = CHECK_WANT})
  if checked.ended ~= "exit" or checked.code ~= 0 then
    print(trim(checked.out))
    fail("book: book_check failed on " .. staging .. ", so /" .. DEST_NAME .. "/ is left as it was")
  end
  for l in lines(checked.out) do
    if starts_with(l, "book_check: ") then print(l) end
  end
  print("book: book_check, shots in " .. SHOTS .. ", took " .. checked.ms .. " ms")
  local moved = must(run({"shale", "--root", ".", MOVE, "stage=" .. STAGED_NAME, "place=" .. DEST_NAME}, {cwd = ROC_APPS, timeout_ms = 60000, tail = 20}))
  print("book: the move into place took " .. moved.ms .. " ms")

  for l in lines(read(REPORT)) do
    if trim(l) ~= "" then print("book: " .. l) end
  end
  print("book: " .. pages .. " pages at http://localhost:9210/" .. DEST_NAME .. "/")
  return nil
end

main()
