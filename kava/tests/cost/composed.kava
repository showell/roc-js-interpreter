// Costs compose through calls. `uniqueCount` claims O(n), and its loop calls
// `seenBefore`, a helper with no claim whose `indexOf` walks the array: the
// helper's work is its caller's, so the claim fails, naming the helper's
// line. `total` calls `sum`, which carries its own claim: `sum` is measured
// on its own, and its work counts in `total`'s too. `joined` grows a string
// in a loop, O(n^2), and claims as much.
function seenBefore(xs, i) {
  return xs.indexOf(xs[i]) < i;
}

function uniqueCount(xs: number[]): number cost O(n) where n = xs.length {
  let count = 0;
  for (let i = 0; i < xs.length; i++) {
    if (!seenBefore(xs, i)) count++;
  }
  return count;
}

size uniqueCount(n) {
  const xs = [];
  for (let i = 0; i < n; i++) xs.push(i % 100);
  return [xs];
}

function sum(xs: number[]): number cost O(n) where n = xs.length {
  let s = 0;
  for (const x of xs) s += x;
  return s;
}

size sum(n) {
  return [Array.from({ length: n }, (_, i) => i)];
}

function total(rows: number[][]): number cost O(n) where n = rows.length {
  let t = 0;
  for (const row of rows) t += sum(row);
  return t;
}

size total(n) {
  return [Array.from({ length: n }, () => [1, 2, 3])];
}

function joined(words: string[]): string cost O(n^2) where n = words.length {
  let s = "";
  for (const w of words) s += w;
  return s;
}

size joined(n) {
  return [Array.from({ length: n }, () => "ab")];
}

console.log(uniqueCount([1, 2, 1, 3]), total([[1, 2], [3]]), joined(["ka", "va"]));
