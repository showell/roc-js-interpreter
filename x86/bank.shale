-- budget: steps=50000000
-- x86/bank.shale: the bank race, x86/bank/bank_race.js, compiled by js-x86
-- against node, as x86/race.shale runs the fib race. Each contestant makes
-- the same TRANSFERS transfers; the race is the wall time of each one's
-- whole run. check.shale does not run it: the full size takes minutes, and
-- its numbers are timings. From the repository's root:
--
--   shale x86/bank.shale                        # the file's own TRANSFERS, about a minute compiled
--   shale x86/bank.shale size=small             # SMALL_TRANSFERS, about a second compiled, for tuning
--   shale x86/bank.shale transfers=2000000      # any count of at least 100,000
--   shale x86/bank.shale size=small runs=5      # five runs of each in turn, and the medians
--
-- `transfers=` (or `size=small`) writes a copy of bank_race.js with its
-- `const TRANSFERS` line changed, under the build mount, and both
-- contestants run the copy; unset, the copy is the file as written.
--
-- It builds js-x86 on the dev backend, writes the race's executable under
-- the build mount, then runs the executable and node, niced, one after the
-- other, never at once (the box has 2 cores), each timed from outside by
-- its wall clock, start to exit. Each contestant's output is checked by
-- x86/bank/verify.js, a second implementation of the ledger, run in node to
-- the same count: its three lines must be verify.js's exactly. Each
-- contestant's line says its wall time and whether its output matched;
-- node's line adds the ratio of the compiled time to node's.

use("./executables.shale")

const WHO = "x86/bank.shale"
const RACE = "x86/bank/bank_race.js"
const VERIFY = "x86/bank/verify.js"
const WANT_VERIFY = "node: verify.js, the second ledger's answer for the race"
const SMALL_TRANSFERS = 2000000
const CHECK_AT = 100000
const TIMEOUT_MS = 600000

-- A contestant's run: its wall time and its output.
function raced(who, argv, want)
  local r = run(argv, {timeout_ms = TIMEOUT_MS, whole = 100000, want = want, nice = 19})
  if r.ended ~= "exit" or r.code ~= 0 then fail(WHO .. ": " .. who .. " ended " .. r.ended .. " " .. get(r, "code", -1) .. ": " .. sub(r.out, 1, 2000)) end
  return {who = who, out = r.out, ms = r.ms}
end

-- verify.js's output for `n` transfers.
function wanted(n)
  local v = run({"node", real(VERIFY), "" .. n}, {timeout_ms = TIMEOUT_MS, whole = 10000, want = WANT_VERIFY, nice = 19})
  if v.code ~= 0 then fail(WHO .. ": verify.js exited " .. get(v, "code", -1) .. ": " .. sub(v.out, 1, 2000)) end
  return v.out
end

-- Whether a contestant's output is verify.js's, and where it isn't.
function checked(c, want)
  if c.out == want then return "matched (verify.js)" end
  local got = lines(c.out)
  local exp = lines(want)
  for i = 1, #exp do
    if i > #got or got[i] ~= exp[i] then
      local line = "(none)"
      if i <= #got then line = got[i] end
      return "WRONG at line " .. i .. ": " .. sub(line, 1, 80) .. ", verify.js's " .. sub(exp[i], 1, 80)
    end
  end
  return "WRONG: " .. #got .. " lines, verify.js " .. #exp
end

-- Milliseconds as seconds, to the hundredth.
function secs(ms)
  local hundredths = (ms + 5) // 10
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac .. " s"
end

-- a / b to the hundredth.
function ratio(a, b)
  local hundredths = (a * 100 + b // 2) // b
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac
end

function median(list)
  local sorted = {}
  for x in list do push(sorted, x) end
  sort(sorted)
  return sorted[(#sorted + 1) // 2]
end

-- The race's text with TRANSFERS set to `n`, and the count it holds.
function race_text(n)
  local text = read(RACE)
  local m = re_find(text, "\nconst TRANSFERS = ([0-9]+);")
  if m == nil then fail(WHO .. ": " .. RACE .. " has no line `const TRANSFERS = <digits>;` to set the count in") end
  if n < 0 then return {text = text, n = tonumber(m.group)} end
  return {text = re_replace(text, "\nconst TRANSFERS = [0-9]+;", "\nconst TRANSFERS = " .. n .. ";"), n = n}
end

function main()
  local size = arg("size", "full")
  local n = arg("transfers", -1)
  local runs = arg("runs", 1)
  if size == "small" then
    if n >= 0 then fail(WHO .. ": give transfers= or size=small, not both") end
    n = SMALL_TRANSFERS
  elseif size ~= "full" then
    fail(WHO .. ": size=" .. size .. " is neither full nor small")
  end
  if runs < 1 then fail(WHO .. ": runs=" .. runs .. " is under 1") end
  local race = race_text(n)
  if race.n < CHECK_AT then fail(WHO .. ": " .. race.n .. " transfers is under " .. CHECK_AT .. ", the count the race's checksum is held at") end
  local exe = built_roc(WHO, "x86/roc/JsToX86.roc", "js-x86", "dev")
  local dir = executables_dir()
  local path = dir .. "/bank-bank_race"
  local copy = dir .. "/bank-bank_race.js"
  replace(copy, race.text)
  local bytes = written_executable(WHO, exe, race.text, path)
  local want = wanted(race.n)
  local node = run({"node", "--version"}, {timeout_ms = 10000, whole = 1000, want = WANT_NODE})
  local uptime = trim(must(run({"uptime"}, {timeout_ms = 10000, whole = 1000})).out)
  print(race.n .. " transfers; the race's executable: " .. bytes .. " bytes; node " .. trim(node.out) .. "; " .. uptime)
  local times = {compiled = {}, node = {}}
  for i = 1, runs do
    local compiled = raced("compiled", {real(path)}, WANT_BINARY)
    local js = raced("node", {"node", real(copy)}, WANT_NODE)
    push(times.compiled, compiled.ms)
    push(times.node, js.ms)
    print("compiled: " .. secs(compiled.ms) .. ", " .. checked(compiled, want))
    print("node: " .. secs(js.ms) .. ", " .. checked(js, want) .. "; compiled/node " .. ratio(compiled.ms, js.ms))
  end
  if runs > 1 then
    local after = trim(must(run({"uptime"}, {timeout_ms = 10000, whole = 1000})).out)
    local c = median(times.compiled)
    local j = median(times.node)
    print("medians of " .. runs .. ": compiled " .. secs(c) .. ", node " .. secs(j) .. "; compiled/node " .. ratio(c, j) .. "; " .. after)
  end
end

main()
