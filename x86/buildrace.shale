-- budget: steps=1000000000 arena_bytes=1500000000 output_bytes=400000 changes=100000
-- x86/buildrace.shale: the build race, and a Roc release's exercise through
-- the races. For each Roc compiler named, it times source in, executable out:
-- js-x86 (built by that Roc, --opt=speed) compiling each race's JavaScript,
-- against `roc build --opt=dev` and `--opt=speed` of the race's Roc port,
-- each cold (an empty Roc cache) and warm (the median of `runs`). It also
-- times js-x86's own release build, holds the executables two compilers'
-- js-x86 write to the same bytes, and runs the Roc races' release
-- executables. x86/buildrace/README.md says what each number means. From the
-- repository's root:
--
--   shale x86/buildrace.shale                 # the pinned Roc alone, every part
--   shale x86/buildrace.shale rocs=tools:roc-0.1.0_RC1/roc,build:scratch/wasm-host/dl/rc2/roc-linux_x86_64-0.1.0-RC2/roc
--   shale x86/buildrace.shale parts=build runs=5
--
-- `rocs=` is a comma-separated list of Roc compilers, each a Shale path (a
-- mount's, `tools:...` or `build:...`) or an absolute one; unset, the one
-- roc-version pins. `parts=` is any of `self` (js-x86's own release build,
-- cold and warm), `bytes` (every program in x86/tests/, x86/tests/refused/,
-- js/tests/ and the four races compiled by each compiler's js-x86, held byte
-- for byte to the first's), `build` (the build race) and `speed` (each Roc
-- race's release executable run, the compilers alternated), in that order;
-- unset, all four. `runs=` (5) is the warm runs of the build race and the
-- speed runs; `self_runs=` (2) the warm runs of js-x86's own build, which
-- takes minutes. Everything runs niced, one program at a time, and each
-- table says the load average before it: other work on the box moves every
-- number, so a run meant to be quoted is made on a quiet box.
--
-- Everything it writes is under `scratch=` (build:scratch/buildrace), one
-- folder a compiler, named by its `roc version`. A cold build's cache is a
-- fresh folder there, set as XDG_CACHE_HOME and TMPDIR, so the compiler finds
-- nothing of an earlier build; the warm builds reuse that folder, and it is
-- removed after them.

use("./executables.shale")

const WHO = "x86/buildrace.shale"
const WANT_UNDER_TEST = "roc-build-race: a Roc compiler under test, building a race"
const WANT_EXE = "x86: a race executable a Roc built, run to time it"
const TIMEOUT_MS = 1800000
const JS_X86_APP = "x86/roc/JsToX86.roc"

-- Each race: its JavaScript, its Roc port (none for big daddy), the Roc
-- executable's name, and the argument its timed run takes (the race scripts'
-- small sizes: about a second each).
const RACES = {
  {name = "fib", js = "x86/race/fib_race.js", roc = "x86/race/fibonacci_race.roc", exe = "fib-race-roc", arg = "100000"},
  {name = "bank", js = "x86/bank/bank_race.js", roc = "x86/bank/bank_race.roc", exe = "bank-race-roc", arg = "2000000"},
  {name = "fourteen", js = "x86/fourteen/fourteen.js", roc = "x86/fourteen/fourteen.roc", exe = "fourteen-roc", arg = "300"},
  {name = "bigdaddy", js = "x86/bigdaddy/bigdaddy_race.js", roc = "", exe = "", arg = ""},
}

-- The three numbers of the load average, now.
function load_average()
  local u = trim(must(run({"uptime"}, {timeout_ms = 10000, whole = 1000})).out)
  local m = re_find(u, "load average: (.*)$")
  if m == nil then return u end
  return m.group
end

-- The wall clock in nanoseconds, for a step that is more than one program.
function clock_ns()
  return tonumber(trim(must(run({"date", "+%s%N"}, {timeout_ms = 10000, whole = 100})).out))
end

function median(list)
  local sorted = {}
  for x in list do push(sorted, x) end
  sort(sorted)
  return sorted[(#sorted + 1) // 2]
end

-- Milliseconds as seconds, to the hundredth.
function secs(ms)
  local hundredths = (ms + 5) // 10
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac .. " s"
end

-- a / b to the hundredth.
function ratio(a, b)
  if b == 0 then return "-" end
  local hundredths = (a * 100 + b // 2) // b
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac
end

-- The OS path of a file that may not exist yet.
function os_path(p)
  return real(dirname(p)) .. "/" .. basename(p)
end

-- A compiler named on the command line: its path, the version it says, and
-- its folder under the scratch folder.
function compiler_of(given, scratch)
  local path = given
  if not starts_with(given, "/") then path = real(given) end
  local v = must(run({path, "version"}, {timeout_ms = 30000, whole = 4000, want = WANT_UNDER_TEST}))
  local m = re_find(v.out, "version ([^ \n]+)")
  if m == nil then fail(WHO .. ": " .. given .. " says no version: " .. trim(v.out)) end
  local dir = scratch .. "/" .. m.group
  mkdir(dir)
  return {path = path, label = m.group, dir = dir, js_x86 = dir .. "/js-x86"}
end

-- One `roc build` of `app` into `out`, with `cache` as the compiler's cache
-- and temporary folder: its wall and CPU time and its count of warnings. An
-- error, or no executable, stops the run.
function roc_build(c, app, mode, out, cache)
  mkdir(cache .. "/tmp")
  if exists(out) then remove(out) end
  local env = {XDG_CACHE_HOME = real(cache), TMPDIR = real(cache .. "/tmp")}
  local argv = {c.path, "build", basename(app), "--opt=" .. mode, "--output=" .. os_path(out)}
  local r = run(argv, {cwd = dirname(app), env = env, timeout_ms = TIMEOUT_MS, tail = 40, nice = 19, want = WANT_UNDER_TEST})
  if contains(r.out, "✗") or not exists(out) then fail(WHO .. ": " .. c.label .. "'s roc build --opt=" .. mode .. " of " .. app .. " failed:\n" .. trim(r.out)) end
  local warned = 0
  for l in lines(r.out) do
    if contains(l, "●") then warned = warned + 1 end
  end
  return {ms = r.ms, cpu_ms = r.cpu_ms, warned = warned}
end

-- A cold build of `app` (a fresh cache), then `runs` warm ones (that cache
-- again): the cold time and the warm times' median, wall and CPU.
function cold_and_warm(c, app, mode, out, runs)
  local cache = fresh_dir(c.dir, "cache")
  local cold = roc_build(c, app, mode, out, cache)
  local warm = {}
  local warm_cpu = {}
  for i = 1, runs do
    local w = roc_build(c, app, mode, out, cache)
    push(warm, w.ms)
    push(warm_cpu, w.cpu_ms)
  end
  remove_tree(cache)
  local w_ms = -1
  local w_cpu = -1
  if runs > 0 then
    w_ms = median(warm)
    w_cpu = median(warm_cpu)
  end
  return {cold = cold.ms, cold_cpu = cold.cpu_ms, warm = w_ms, warm_cpu = w_cpu, warned = cold.warned}
end

-- js-x86's release build for `c`, made untimed when no earlier part made it.
function ensure_js_x86(c)
  if exists(c.js_x86) then return nil end
  local cache = fresh_dir(c.dir, "cache")
  roc_build(c, JS_X86_APP, "speed", c.js_x86, cache)
  remove_tree(cache)
  return nil
end

-- One compile by `c`'s js-x86 of `text` into the executable at `path`: the
-- driver's own wall time, and the whole step's (the driver, then the hex
-- carried to the file and made executable), or the refusal.
function js_x86_once(c, text, path)
  local t0 = clock_ns()
  local r = run({real(c.js_x86), text}, {timeout_ms = 60000, whole = 4000000, nice = 19, want = WANT_DRIVER})
  if r.ended ~= "exit" or r.code ~= 0 then return {refused = trim(sub(r.out, 1, 300))} end
  hex_written(WHO, r.out, path)
  local t1 = clock_ns()
  return {driver = r.ms, total = (t1 - t0) // 1000000, refused = ""}
end

-- The js-x86 release build's own times, for each compiler.
function part_self(compilers, runs)
  print("")
  print("## js-x86's own release build (--opt=speed), load " .. load_average())
  print("")
  print("| compiler | cold | warm (median of " .. runs .. ") | cold CPU | warm CPU | warnings |")
  print("|---|---|---|---|---|---|")
  for c in compilers do
    local t = cold_and_warm(c, JS_X86_APP, "speed", c.js_x86, runs)
    print("| " .. c.label .. " | " .. secs(t.cold) .. " | " .. secs(t.warm) .. " | " .. secs(t.cold_cpu) .. " | " .. secs(t.warm_cpu) .. " | " .. t.warned .. " |")
  end
  print("load after: " .. load_average())
  return nil
end

-- Every program the byte-identity part compiles, by its path.
function identity_programs()
  local out = {}
  for p in glob("x86/tests/*.js") do push(out, p) end
  for p in glob("x86/tests/refused/*.js") do push(out, p) end
  for p in glob("js/tests/*.js") do push(out, p) end
  for r in RACES do push(out, r.js) end
  return out
end

function sha256(text)
  local r = must(run({"sha256sum"}, {stdin = text, timeout_ms = 60000, tail = 2}))
  return sub(trim(r.out), 1, 64)
end

-- Each program compiled by each compiler's js-x86, its output (the hex of
-- the executable, or the refusal) and exit held to the first compiler's.
function part_bytes(compilers)
  print("")
  print("## Byte identity, load " .. load_average())
  local programs = identity_programs()
  local differ = 0
  local made = 0
  for p in programs do
    local text = read(p)
    local first = ""
    local first_code = 0
    for i = 1, #compilers do
      local r = run({real(compilers[i].js_x86), text}, {timeout_ms = 60000, whole = 4000000, nice = 19, want = WANT_DRIVER})
      local h = sha256(r.out)
      if i == 1 then
        first = h
        first_code = get(r, "code", -1)
        if first_code == 0 then made = made + 1 end
      elseif h ~= first or get(r, "code", -1) ~= first_code then
        differ = differ + 1
        print("DIFFERS  " .. p .. ": " .. compilers[1].label .. " exit " .. first_code .. " sha256 " .. sub(first, 1, 16) .. ", " .. compilers[i].label .. " exit " .. get(r, "code", -1) .. " sha256 " .. sub(h, 1, 16))
      end
    end
    yield()
  end
  print(#programs .. " programs (" .. made .. " compiled to an executable, " .. (#programs - made) .. " refused), " .. differ .. " differing across " .. #compilers .. " compilers")
  return nil
end

-- One race's build race, a table: js-x86 by each compiler, then roc build
-- --opt=dev and --opt=speed by each.
function race_table(race, compilers, runs)
  print("")
  print("### " .. race.name .. ", load " .. load_average())
  print("")
  print("| contestant | cold | warm (median of " .. runs .. ") | warnings |")
  print("|---|---|---|---|")
  local text = read(race.js)
  for c in compilers do
    local path = c.dir .. "/" .. race.name .. "-js-x86"
    local first = js_x86_once(c, text, path)
    if first.refused ~= "" then
      print("| js-x86 (built by " .. c.label .. ") | refused: " .. re_replace(first.refused, "\\|", "/") .. " | | |")
    else
      local warm = {}
      local driver = {}
      for i = 1, runs do
        local w = js_x86_once(c, text, path)
        push(warm, w.total)
        push(driver, w.driver)
      end
      print("| js-x86 (built by " .. c.label .. ") | " .. first.total .. " ms | " .. median(warm) .. " ms (js-x86 alone " .. median(driver) .. " ms) | |")
    end
  end
  if race.roc ~= "" then
    for mode in {"dev", "speed"} do
      for c in compilers do
        local out = c.dir .. "/" .. race.exe .. "-" .. mode
        local t = cold_and_warm(c, race.roc, mode, out, runs)
        print("| roc build --opt=" .. mode .. " (" .. c.label .. ") | " .. secs(t.cold) .. " | " .. secs(t.warm) .. " | " .. t.warned .. " |")
      end
    end
  end
  return nil
end

function part_build(compilers, runs)
  print("")
  print("## The build race: source in, executable out")
  for race in RACES do race_table(race, compilers, runs) end
  print("load after: " .. load_average())
  return nil
end

-- Each Roc race's release executable, made untimed when the build race
-- didn't make it, run `runs` times with the compilers alternated; their
-- outputs held to each other's.
function part_speed(compilers, runs)
  print("")
  print("## The Roc races' release executables, load " .. load_average())
  print("")
  local head = "| race (argument) |"
  local rule = "|---|"
  for c in compilers do
    head = head .. " " .. c.label .. " (median of " .. runs .. ") |"
    rule = rule .. "---|"
  end
  if #compilers > 1 then
    head = head .. " " .. compilers[#compilers].label .. "/" .. compilers[1].label .. " |"
    rule = rule .. "---|"
  end
  print(head)
  print(rule)
  for race in RACES do
    if race.roc ~= "" then
      for c in compilers do
        local out = c.dir .. "/" .. race.exe .. "-speed"
        if not exists(out) then
          local cache = fresh_dir(c.dir, "cache")
          roc_build(c, race.roc, "speed", out, cache)
          remove_tree(cache)
        end
      end
      local times = {}
      local outputs = {}
      for c in compilers do
        times[c.label] = {}
        outputs[c.label] = ""
      end
      for i = 1, runs do
        for c in compilers do
          local r = run({real(c.dir .. "/" .. race.exe .. "-speed"), race.arg}, {timeout_ms = 600000, whole = 4000000, nice = 19, want = WANT_EXE})
          if r.ended ~= "exit" or r.code ~= 0 then fail(WHO .. ": " .. c.label .. "'s " .. race.exe .. " ended " .. r.ended .. ": " .. sub(r.out, 1, 500)) end
          push(times[c.label], r.ms)
          outputs[c.label] = r.out
        end
      end
      local row = "| " .. race.name .. " (" .. race.arg .. ") |"
      for c in compilers do row = row .. " " .. median(times[c.label]) .. " ms |" end
      if #compilers > 1 then row = row .. " " .. ratio(median(times[compilers[#compilers].label]), median(times[compilers[1].label])) .. " |" end
      print(row)
      for c in compilers do
        if outputs[c.label] ~= outputs[compilers[1].label] then print("OUTPUT DIFFERS: " .. race.name .. ", " .. c.label .. " against " .. compilers[1].label) end
      end
    end
  end
  print("load after: " .. load_average())
  return nil
end

-- Each executable a Roc built here (js-x86 and the races' dev and speed
-- builds), held byte for byte to the first compiler's: when two compilers
-- write the same bytes, their run times differ only by the box's noise.
function part_same(compilers)
  if #compilers < 2 then return nil end
  print("")
  print("## The Roc-built executables, byte for byte against " .. compilers[1].label)
  print("")
  local names = {"js-x86"}
  for race in RACES do
    if race.exe ~= "" then
      push(names, race.exe .. "-dev")
      push(names, race.exe .. "-speed")
    end
  end
  for n in names do
    local first = compilers[1].dir .. "/" .. n
    if exists(first) then
      local want = sub(must(run({"sha256sum", real(first)}, {timeout_ms = 30000, whole = 1000})).out, 1, 64)
      for i = 2, #compilers do
        local other = compilers[i].dir .. "/" .. n
        local said = "missing"
        if exists(other) then
          local got = sub(must(run({"sha256sum", real(other)}, {timeout_ms = 30000, whole = 1000})).out, 1, 64)
          said = "DIFFERS"
          if got == want then said = "identical" end
        end
        print("- " .. n .. " (" .. stat(first).size .. " bytes): " .. compilers[i].label .. "'s " .. said)
      end
    end
  end
  return nil
end

function main()
  local scratch = arg("scratch", "build:scratch/buildrace")
  local rocs = arg("rocs", "")
  local parts = set_of(split(arg("parts", "self,bytes,build,speed"), ","))
  local runs = arg("runs", 5)
  local self_runs = arg("self_runs", 2)
  for p in keys(parts) do
    if not has_item({"self", "bytes", "build", "speed"}, p) then fail(WHO .. ": parts= is self, bytes, build or speed, not " .. p) end
  end
  mkdir(scratch)
  local given = {}
  if rocs == "" then push(given, pinned_roc(WHO)) else given = split(rocs, ",") end
  local compilers = {}
  for g in given do push(compilers, compiler_of(g, scratch)) end
  local names = {}
  for c in compilers do push(names, c.label) end
  print("# Build race: " .. join(names, ", ") .. "; load " .. load_average())
  if has_key(parts, "self") then part_self(compilers, self_runs) end
  for c in compilers do ensure_js_x86(c) end
  if has_key(parts, "bytes") then part_bytes(compilers) end
  if has_key(parts, "build") then part_build(compilers, runs) end
  if has_key(parts, "speed") then part_speed(compilers, runs) end
  part_same(compilers)
  return nil
end

main()
