-- budget: steps=1000000000 arena_bytes=1500000000 output_bytes=400000 changes=100000
-- x86/buildrace.shale: the build race, and a Roc release's exercise through
-- the races. For each Roc compiler named, it times source in, executable out:
-- js-x86 (built by that Roc, --opt=speed) compiling each race's JavaScript,
-- against `roc build --opt=dev` and `--opt=speed` of the race's Roc port,
-- each cold (an empty Roc cache) and warm (the median of `runs`). It also
-- times js-x86's own release build, holds the executables two compilers'
-- js-x86 write to the same bytes, and runs the Roc races' release
-- executables. x86/buildrace/README.md says what each number means. From the
-- repository's root:
--
--   shale x86/buildrace.shale                 # the pinned Roc alone, every part
--   shale x86/buildrace.shale rocs=tools:roc-0.1.0_RC1/roc,build:scratch/wasm-host/dl/rc2/roc-linux_x86_64-0.1.0-RC2/roc
--   shale x86/buildrace.shale parts=build runs=5
--
-- `rocs=` is a comma-separated list of Roc compilers, each a Shale path (a
-- mount's, `tools:...` or `build:...`) or an absolute one; unset, the one
-- roc-version pins. `parts=` is any of `self` (js-x86's own release build,
-- cold and warm), `bytes` (every program in x86/tests/, x86/tests/refused/,
-- js/tests/ and the four races compiled by each compiler's js-x86, held byte
-- for byte to the first's), `build` (the build race) and `speed` (each Roc
-- race's release executable run, the compilers alternated), in that order;
-- unset, all four. `runs=` (5) is the warm runs of the build race and the
-- speed runs; `self_runs=` (2) the warm runs of js-x86's own build, which
-- takes minutes. Everything runs niced, one program at a time, and each
-- table says the load average before it: other work on the box moves every
-- number, so a run meant to be quoted is made on a quiet box.
--
-- `parts=size` builds each executable once, untimed, and reports sizes
-- alone, so they can be had quickly on a busy box: js-x86's executable of
-- each race (written by js-x86's dev build, tools/roc_build.shale's cached
-- one, since the bytes it writes are the release build's), and each Roc
-- race's dev and speed builds, one cold build each. Every run that has
-- `build`, `speed` or `size` in its parts ends with the summary: each
-- executable's warm build time, its run time, its size in bytes, raw and
-- after `strip` (of a copy, `strip -o`), `size`'s text, data and bss, and
-- how `file` says it is linked.
--
-- Everything it writes is under `scratch=` (build:scratch/buildrace), one
-- folder a compiler, named by its `roc version`. A cold build's cache is a
-- fresh folder there, set as XDG_CACHE_HOME and TMPDIR, so the compiler finds
-- nothing of an earlier build; the warm builds reuse that folder, and it is
-- removed after them.

use("./executables.shale")

const WHO = "x86/buildrace.shale"
const WANT_UNDER_TEST = "roc-build-race: a Roc compiler under test, building a race"
const WANT_EXE = "x86: a race executable, run to time it"
const TIMEOUT_MS = 1800000
const JS_X86_APP = "x86/roc/JsToX86.roc"

-- Each race: its JavaScript, its Roc port (none for big daddy), the Roc
-- executable's name, and the size its timed run takes (the race scripts'
-- small sizes: about a second each). The Roc executable takes the size as
-- its argument; js-x86's is compiled from a copy of the JavaScript with its
-- `const <knob>` line set to it, as the race scripts' copies are.
const RACES = {
  {name = "fib", js = "x86/race/fib_race.js", roc = "x86/race/fibonacci_race.roc", exe = "fib-race-roc", knob = "N", arg = "100000"},
  {name = "bank", js = "x86/bank/bank_race.js", roc = "x86/bank/bank_race.roc", exe = "bank-race-roc", knob = "TRANSFERS", arg = "2000000"},
  {name = "fourteen", js = "x86/fourteen/fourteen.js", roc = "x86/fourteen/fourteen.roc", exe = "fourteen-roc", knob = "ROUNDS", arg = "300"},
  {name = "bigdaddy", js = "x86/bigdaddy/bigdaddy_race.js", roc = "", exe = "", knob = "ROUNDS", arg = "30"},
}

-- What this run measured and made: `build` and `run` hold a time by the
-- executable's key (`exe_key`), `made` each executable written in this run
-- (so none from an earlier run, of older code, is measured), and `refused`
-- js-x86's refusal by the executable's path.
const board = {build = {}, run = {}, made = {}, refused = {}}

-- The three numbers of the load average, now.
function load_average()
  local u = trim(must(run({"uptime"}, {timeout_ms = 10000, whole = 1000})).out)
  local m = re_find(u, "load average: (.*)$")
  if m == nil then return u end
  return m.group
end

-- The wall clock in nanoseconds, for a step that is more than one program.
function clock_ns()
  return tonumber(trim(must(run({"date", "+%s%N"}, {timeout_ms = 10000, whole = 100})).out))
end

function median(list)
  local sorted = {}
  for x in list do push(sorted, x) end
  sort(sorted)
  return sorted[(#sorted + 1) // 2]
end

-- Milliseconds as seconds, to the hundredth.
function secs(ms)
  local hundredths = (ms + 5) // 10
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac .. " s"
end

-- a / b to the hundredth.
function ratio(a, b)
  if b == 0 then return "-" end
  local hundredths = (a * 100 + b // 2) // b
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac
end

-- A whole number with its thousands marked: 1,234,567.
function grouped(n)
  local s = "" .. n
  local out = ""
  while #s > 3 do
    out = "," .. sub(s, #s - 2, #s) .. out
    s = sub(s, 1, #s - 3)
  end
  return s .. out
end

-- The value of a hex number as readelf prints it, `0x` and all.
function hex_value(s)
  local t = s
  if starts_with(t, "0x") then t = sub(t, 3) end
  local n = 0
  for i = 1, #t do
    local d = find(HEX_DIGITS, sub(t, i, i))
    if d == nil then fail(WHO .. ": " .. s .. " is not a hex number") end
    n = n * 16 + d - 1
  end
  return n
end

-- The OS path of a file that may not exist yet.
function os_path(p)
  return real(dirname(p)) .. "/" .. basename(p)
end

-- A compiler named on the command line: its path, the version it says, and
-- its folder under the scratch folder.
function compiler_of(given, scratch)
  local path = given
  if not starts_with(given, "/") then path = real(given) end
  local v = must(run({path, "version"}, {timeout_ms = 30000, whole = 4000, want = WANT_UNDER_TEST}))
  local m = re_find(v.out, "version ([^ \n]+)")
  if m == nil then fail(WHO .. ": " .. given .. " says no version: " .. trim(v.out)) end
  local dir = scratch .. "/" .. m.group
  mkdir(dir)
  return {path = path, label = m.group, dir = dir, js_x86 = dir .. "/js-x86"}
end

-- One `roc build` of `app` into `out`, with `cache` as the compiler's cache
-- and temporary folder: its wall and CPU time and its count of warnings. An
-- error, or no executable, stops the run.
function roc_build(c, app, mode, out, cache)
  mkdir(cache .. "/tmp")
  if exists(out) then remove(out) end
  local env = {XDG_CACHE_HOME = real(cache), TMPDIR = real(cache .. "/tmp")}
  local argv = {c.path, "build", basename(app), "--opt=" .. mode, "--output=" .. os_path(out)}
  local r = run(argv, {cwd = dirname(app), env = env, timeout_ms = TIMEOUT_MS, tail = 40, nice = 19, want = WANT_UNDER_TEST})
  if contains(r.out, "✗") or not exists(out) then fail(WHO .. ": " .. c.label .. "'s roc build --opt=" .. mode .. " of " .. app .. " failed:\n" .. trim(r.out)) end
  local warned = 0
  for l in lines(r.out) do
    if contains(l, "●") then warned = warned + 1 end
  end
  return {ms = r.ms, cpu_ms = r.cpu_ms, warned = warned}
end

-- A cold build of `app` (a fresh cache), then `runs` warm ones (that cache
-- again): the cold time and the warm times' median, wall and CPU.
function cold_and_warm(c, app, mode, out, runs)
  local cache = fresh_dir(c.dir, "cache")
  local cold = roc_build(c, app, mode, out, cache)
  local warm = {}
  local warm_cpu = {}
  for i = 1, runs do
    local w = roc_build(c, app, mode, out, cache)
    push(warm, w.ms)
    push(warm_cpu, w.cpu_ms)
  end
  remove_tree(cache)
  local w_ms = -1
  local w_cpu = -1
  if runs > 0 then
    w_ms = median(warm)
    w_cpu = median(warm_cpu)
  end
  return {cold = cold.ms, cold_cpu = cold.cpu_ms, warm = w_ms, warm_cpu = w_cpu, warned = cold.warned}
end

function sha256(text)
  local r = must(run({"sha256sum"}, {stdin = text, timeout_ms = 60000, tail = 2}))
  return sub(trim(r.out), 1, 64)
end

-- What js-x86 is built from: git's tree of x86/roc at HEAD, and the hash of
-- its uncommitted changes when there are any.
function js_x86_source()
  local tree = trim(must(run({"git", "rev-parse", "HEAD:x86/roc"}, {timeout_ms = 30000, whole = 1000})).out)
  local changed = must(run({"git", "status", "--porcelain", "--", "x86/roc"}, {timeout_ms = 30000, whole = 100000})).out
  if trim(changed) == "" then return tree end
  local diff = must(run({"git", "diff", "HEAD", "--", "x86/roc"}, {timeout_ms = 30000, whole = 4000000})).out
  return tree .. " + " .. sha256(changed .. diff)
end

-- Beside js-x86's release build, what it was built from.
function note_js_x86_source(c)
  local note = c.js_x86 .. ".source"
  if exists(note) then remove(note) end
  create(note, js_x86_source() .. "\n")
  return nil
end

-- js-x86's release build for `c`, made untimed when no earlier part made it
-- from this checkout's x86/roc (an earlier run's, of other code, is rebuilt).
function ensure_js_x86(c)
  local note = c.js_x86 .. ".source"
  if exists(c.js_x86) and exists(note) and trim(read(note)) == js_x86_source() then return nil end
  local cache = fresh_dir(c.dir, "cache")
  roc_build(c, JS_X86_APP, "speed", c.js_x86, cache)
  remove_tree(cache)
  note_js_x86_source(c)
  return nil
end

-- One compile by `c`'s js-x86 of `text` into the executable at `path`: the
-- driver's own wall time, and the whole step's (the driver, then the hex
-- carried to the file and made executable), or the refusal.
function js_x86_once(c, text, path)
  local t0 = clock_ns()
  local r = run({c.driver, text}, {timeout_ms = 300000, whole = 4000000, nice = 19, want = WANT_DRIVER})
  if r.ended ~= "exit" then fail(WHO .. ": js-x86 ended " .. r.ended .. " on " .. path .. ": " .. sub(r.out, 1, 300)) end
  if r.code ~= 0 then return {refused = trim(sub(r.out, 1, 300))} end
  hex_written(WHO, r.out, path)
  local t1 = clock_ns()
  return {driver = r.ms, total = (t1 - t0) // 1000000, refused = ""}
end

-- The js-x86 release build's own times, for each compiler.
function part_self(compilers, runs)
  print("")
  print("## js-x86's own release build (--opt=speed), load " .. load_average())
  print("")
  print("| compiler | cold | warm (median of " .. runs .. ") | cold CPU | warm CPU | warnings |")
  print("|---|---|---|---|---|---|")
  for c in compilers do
    local t = cold_and_warm(c, JS_X86_APP, "speed", c.js_x86, runs)
    note_js_x86_source(c)
    print("| " .. c.label .. " | " .. secs(t.cold) .. " | " .. secs(t.warm) .. " | " .. secs(t.cold_cpu) .. " | " .. secs(t.warm_cpu) .. " | " .. t.warned .. " |")
  end
  print("load after: " .. load_average())
  return nil
end

-- Every program the byte-identity part compiles, by its path.
function identity_programs()
  local out = {}
  for p in glob("x86/tests/*.js") do push(out, p) end
  for p in glob("x86/tests/refused/*.js") do push(out, p) end
  for p in glob("js/tests/*.js") do push(out, p) end
  for r in RACES do push(out, r.js) end
  return out
end

-- Each program compiled by each compiler's js-x86, its output (the hex of
-- the executable, or the refusal) and exit held to the first compiler's.
function part_bytes(compilers)
  print("")
  print("## Byte identity, load " .. load_average())
  local programs = identity_programs()
  local differ = 0
  local made = 0
  for p in programs do
    local text = read(p)
    local first = ""
    local first_code = 0
    for i = 1, #compilers do
      local r = run({compilers[i].driver, text}, {timeout_ms = 60000, whole = 4000000, nice = 19, want = WANT_DRIVER})
      local h = sha256(r.out)
      if i == 1 then
        first = h
        first_code = get(r, "code", -1)
        if first_code == 0 then made = made + 1 end
      elseif h ~= first or get(r, "code", -1) ~= first_code then
        differ = differ + 1
        print("DIFFERS  " .. p .. ": " .. compilers[1].label .. " exit " .. first_code .. " sha256 " .. sub(first, 1, 16) .. ", " .. compilers[i].label .. " exit " .. get(r, "code", -1) .. " sha256 " .. sub(h, 1, 16))
      end
    end
    yield()
  end
  print(#programs .. " programs (" .. made .. " compiled to an executable, " .. (#programs - made) .. " refused), " .. differ .. " differing across " .. #compilers .. " compilers")
  return nil
end

-- The three kinds of executable: js-x86's of a race, and Roc's dev and
-- speed builds of its port.
function kinds_of(race)
  if race.roc == "" then return {"js-x86"} end
  return {"js-x86", "dev", "speed"}
end

-- Where `c`'s executable of `kind` for `race` is written.
function exe_path(c, race, kind)
  if kind == "js-x86" then return c.dir .. "/" .. race.name .. "-js-x86" end
  return c.dir .. "/" .. race.exe .. "-" .. kind
end

-- Its key in the board, and the name the tables give it.
function exe_key(c, race, kind)
  return race.name .. "|" .. kind .. "|" .. c.label
end

function exe_name(c, kind)
  if kind == "js-x86" then return "js-x86 (built by " .. c.label .. ")" end
  return "roc --opt=" .. kind .. " (" .. c.label .. ")"
end

-- The race's JavaScript with its `const <knob>` line set to the timed run's
-- size.
function sized_js(race)
  local text = read(race.js)
  local line = "\nconst " .. race.knob .. " = [0-9]+;"
  if re_find(text, line) == nil then fail(WHO .. ": " .. race.js .. " has no line `const " .. race.knob .. " = <digits>;` to set the size in") end
  return re_replace(text, line, "\nconst " .. race.knob .. " = " .. race.arg .. ";")
end

-- `c`'s executable of `kind` for `race`, made untimed (a Roc build cold, in
-- a fresh cache) unless this run already made it: js-x86's refusal, or "".
function made_now(c, race, kind)
  local path = exe_path(c, race, kind)
  if not get(board.made, path, false) then
    if kind == "js-x86" then
      local w = js_x86_once(c, read(race.js), path)
      board.refused[path] = w.refused
    else
      local cache = fresh_dir(c.dir, "cache")
      roc_build(c, race.roc, kind, path, cache)
      remove_tree(cache)
    end
    board.made[path] = true
  end
  return get(board.refused, path, "")
end

-- One race's build race, a table: js-x86 by each compiler, then roc build
-- --opt=dev and --opt=speed by each.
function race_table(race, compilers, runs)
  print("")
  print("### " .. race.name .. ", load " .. load_average())
  print("")
  print("| contestant | cold | warm (median of " .. runs .. ") | warnings |")
  print("|---|---|---|---|")
  local text = read(race.js)
  for c in compilers do
    local path = exe_path(c, race, "js-x86")
    local first = js_x86_once(c, text, path)
    board.made[path] = true
    board.refused[path] = first.refused
    if first.refused ~= "" then
      print("| js-x86 (built by " .. c.label .. ") | refused: " .. re_replace(first.refused, "\\|", "/") .. " | | |")
    else
      local warm = {}
      local driver = {}
      for i = 1, runs do
        local w = js_x86_once(c, text, path)
        push(warm, w.total)
        push(driver, w.driver)
      end
      local w = first.total
      if runs > 0 then w = median(warm) end
      board.build[exe_key(c, race, "js-x86")] = w
      print("| js-x86 (built by " .. c.label .. ") | " .. first.total .. " ms | " .. median(warm) .. " ms (js-x86 alone " .. median(driver) .. " ms) | |")
    end
  end
  if race.roc ~= "" then
    for mode in {"dev", "speed"} do
      for c in compilers do
        local out = exe_path(c, race, mode)
        local t = cold_and_warm(c, race.roc, mode, out, runs)
        board.made[out] = true
        local w = t.cold
        if runs > 0 then w = t.warm end
        board.build[exe_key(c, race, mode)] = w
        print("| roc build --opt=" .. mode .. " (" .. c.label .. ") | " .. secs(t.cold) .. " | " .. secs(t.warm) .. " | " .. t.warned .. " |")
      end
    end
  end
  return nil
end

function part_build(compilers, runs)
  print("")
  print("## The build race: source in, executable out")
  for race in RACES do race_table(race, compilers, runs) end
  print("load after: " .. load_average())
  return nil
end

-- Each Roc race's release executable, made untimed when the build race
-- didn't make it, and js-x86's executable of each race at the same size
-- (written afresh from the sized copy, untimed), run `runs` times with the
-- executables and the compilers taking turns; each kind's outputs held to
-- the first compiler's.
function part_speed(compilers, runs)
  print("")
  print("## The races' executables at speed, load " .. load_average())
  print("")
  local head = "| race (size), executable |"
  local rule = "|---|"
  for c in compilers do
    head = head .. " " .. c.label .. " (median of " .. runs .. ") |"
    rule = rule .. "---|"
  end
  if #compilers > 1 then
    head = head .. " " .. compilers[#compilers].label .. "/" .. compilers[1].label .. " |"
    rule = rule .. "---|"
  end
  print(head)
  print(rule)
  for race in RACES do
    local sized = sized_js(race)
    -- Each contestant: its kind, and by compiler the argv that runs it.
    local contestants = {}
    local js = {kind = "js-x86", argv = {}}
    for c in compilers do
      local path = c.dir .. "/" .. race.name .. "-js-x86-sized"
      local w = js_x86_once(c, sized, path)
      if w.refused ~= "" then
        print("| " .. race.name .. " (" .. race.arg .. "), js-x86 (built by " .. c.label .. ") | refused: " .. re_replace(w.refused, "\\|", "/") .. " |")
      else
        js.argv[c.label] = {real(path)}
      end
    end
    if #keys(js.argv) == #compilers then push(contestants, js) end
    if race.roc ~= "" then
      local roc = {kind = "speed", argv = {}}
      for c in compilers do
        made_now(c, race, "speed")
        roc.argv[c.label] = {real(exe_path(c, race, "speed")), race.arg}
      end
      push(contestants, roc)
    end
    local times = {}
    local outputs = {}
    for e in contestants do
      times[e.kind] = {}
      outputs[e.kind] = {}
      for c in compilers do times[e.kind][c.label] = {} end
    end
    for i = 1, runs do
      for e in contestants do
        for c in compilers do
          local r = run(e.argv[c.label], {timeout_ms = 600000, whole = 4000000, nice = 19, want = WANT_EXE})
          if r.ended ~= "exit" or r.code ~= 0 then fail(WHO .. ": " .. c.label .. "'s " .. race.name .. " " .. e.kind .. " executable ended " .. r.ended .. ": " .. sub(r.out, 1, 500)) end
          push(times[e.kind][c.label], r.ms)
          outputs[e.kind][c.label] = r.out
        end
      end
    end
    for e in contestants do
      local what = "js-x86"
      if e.kind ~= "js-x86" then what = "roc --opt=" .. e.kind end
      local row = "| " .. race.name .. " (" .. race.arg .. "), " .. what .. " |"
      for c in compilers do
        local m = median(times[e.kind][c.label])
        board.run[exe_key(c, race, e.kind)] = m
        row = row .. " " .. m .. " ms |"
      end
      if #compilers > 1 then row = row .. " " .. ratio(median(times[e.kind][compilers[#compilers].label]), median(times[e.kind][compilers[1].label])) .. " |" end
      print(row)
      for c in compilers do
        if outputs[e.kind][c.label] ~= outputs[e.kind][compilers[1].label] then print("OUTPUT DIFFERS: " .. race.name .. " " .. what .. ", " .. c.label .. " against " .. compilers[1].label) end
      end
    end
  end
  print("load after: " .. load_average())
  return nil
end

-- An executable's size: its bytes, raw and stripped (`strip -o` writes a
-- copy, so the executable is never changed), `size`'s text, data and bss,
-- and what `file` says of it. An executable with no section headers
-- (js-x86's) has nothing for `strip` to take and nothing for `size` to
-- count, so its text, data and bss are its load segments' (`readelf -l`):
-- an executable segment's file bytes are text, a writable one's are data,
-- and what its memory has past them is bss.
function sizes_of(path)
  local p = real(path)
  local described = trim(must(run({"file", "-b", p}, {timeout_ms = 10000, whole = 4000})).out)
  described = re_replace(described, ", BuildID\\[[a-z0-9]+\\]=[0-9a-f]+", "")
  local linked = "unknown"
  if contains(described, "static-pie linked") then
    linked = "static-pie"
  elseif contains(described, "statically linked") then
    linked = "static"
  elseif contains(described, "dynamically linked") then
    linked = "dynamic"
  end
  local sectionless = contains(described, "no section header")
  if sectionless then linked = linked .. ", no sections" end
  local raw = stat(path).size
  local stripped = raw
  if not sectionless then
    local copy = path .. ".stripped"
    if exists(copy) then remove(copy) end
    local s = run({"strip", "-o", os_path(copy), p}, {timeout_ms = 60000, tail = 20})
    if s.code ~= 0 or not exists(copy) then fail(WHO .. ": strip of " .. path .. " exited " .. get(s, "code", -1) .. ": " .. trim(s.out)) end
    stripped = stat(copy).size
    remove(copy)
  end
  local text = 0
  local data = 0
  local bss = 0
  if sectionless then
    local out = must(run({"readelf", "-lW", p}, {timeout_ms = 10000, whole = 100000})).out
    for l in lines(out) do
      local w = words(l)
      if #w >= 7 and w[1] == "LOAD" then
        local file_bytes = hex_value(w[5])
        local memory = hex_value(w[6])
        local flags = join(slice(w, 7, #w - 1), "")
        if contains(flags, "E") then
          text = text + file_bytes
        elseif contains(flags, "W") then
          data = data + file_bytes
          bss = bss + memory - file_bytes
        else
          text = text + file_bytes
        end
      end
    end
  else
    local out = must(run({"size", p}, {timeout_ms = 10000, whole = 4000})).out
    local w = words(lines(trim(out))[2])
    text = tonumber(w[1])
    data = tonumber(w[2])
    bss = tonumber(w[3])
  end
  return {raw = raw, stripped = stripped, text = text, data = data, bss = bss, linked = linked, described = described}
end

-- The summary: every executable of each race, made untimed when this run
-- hasn't made it, with its warm build time and its run time (when the build
-- and speed parts measured them) and its sizes; then what `file` says of
-- each kind.
function part_summary(compilers)
  print("")
  print("## The executables: build time, run time and size, load " .. load_average())
  print("")
  print("| race | executable | build (warm) | run | bytes | stripped | text | data | bss | linked |")
  print("|---|---|---|---|---|---|---|---|---|---|")
  local said = {}
  local order = {}
  for race in RACES do
    for kind in kinds_of(race) do
      for c in compilers do
        local name = exe_name(c, kind)
        local refused = made_now(c, race, kind)
        local key = exe_key(c, race, kind)
        local build = "-"
        if has_key(board.build, key) then build = secs(board.build[key]) end
        local ran = "-"
        if has_key(board.run, key) then ran = secs(board.run[key]) end
        if refused ~= "" then
          print("| " .. race.name .. " | " .. name .. " | refused: " .. re_replace(refused, "\\|", "/") .. " | | | | | | | |")
        else
          local s = sizes_of(exe_path(c, race, kind))
          print("| " .. race.name .. " | " .. name .. " | " .. build .. " | " .. ran .. " | " .. grouped(s.raw) .. " | " .. grouped(s.stripped) .. " | " .. grouped(s.text) .. " | " .. grouped(s.data) .. " | " .. grouped(s.bss) .. " | " .. s.linked .. " |")
          if not has_key(said, s.described) then
            said[s.described] = {}
            push(order, s.described)
          end
          if not has_item(said[s.described], name) then push(said[s.described], name) end
        end
      end
    end
    yield()
  end
  print("")
  for d in order do print("- " .. join(said[d], ", ") .. ": `file` says " .. d) end
  return nil
end

-- Each executable a Roc built here (js-x86 and the races' dev and speed
-- builds), held byte for byte to the first compiler's: when two compilers
-- write the same bytes, their run times differ only by the box's noise.
function part_same(compilers)
  if #compilers < 2 then return nil end
  print("")
  print("## The Roc-built executables, byte for byte against " .. compilers[1].label)
  print("")
  local names = {"js-x86"}
  for race in RACES do
    if race.exe ~= "" then
      push(names, race.exe .. "-dev")
      push(names, race.exe .. "-speed")
    end
  end
  for n in names do
    local first = compilers[1].dir .. "/" .. n
    if exists(first) then
      local want = sub(must(run({"sha256sum", real(first)}, {timeout_ms = 30000, whole = 1000})).out, 1, 64)
      for i = 2, #compilers do
        local other = compilers[i].dir .. "/" .. n
        local said = "missing"
        if exists(other) then
          local got = sub(must(run({"sha256sum", real(other)}, {timeout_ms = 30000, whole = 1000})).out, 1, 64)
          said = "DIFFERS"
          if got == want then said = "identical" end
        end
        print("- " .. n .. " (" .. stat(first).size .. " bytes): " .. compilers[i].label .. "'s " .. said)
      end
    end
  end
  return nil
end

function main()
  local scratch = arg("scratch", "build:scratch/buildrace")
  local rocs = arg("rocs", "")
  local parts = set_of(split(arg("parts", "self,bytes,build,speed"), ","))
  local timed = has_key(parts, "self") or has_key(parts, "bytes") or has_key(parts, "build") or has_key(parts, "speed")
  local runs = arg("runs", 5)
  local self_runs = arg("self_runs", 2)
  for p in keys(parts) do
    if not has_item({"self", "bytes", "build", "speed", "size"}, p) then fail(WHO .. ": parts= is self, bytes, build, speed or size, not " .. p) end
  end
  mkdir(scratch)
  local given = {}
  if rocs == "" then push(given, pinned_roc(WHO)) else given = split(rocs, ",") end
  local compilers = {}
  for g in given do push(compilers, compiler_of(g, scratch)) end
  local names = {}
  for c in compilers do push(names, c.label) end
  print("# Build race: " .. join(names, ", ") .. "; load " .. load_average())
  if has_key(parts, "self") then part_self(compilers, self_runs) end
  if timed then
    for c in compilers do
      ensure_js_x86(c)
      c.driver = real(c.js_x86)
    end
  else
    -- Sizes alone: js-x86's dev build writes the release build's bytes, and
    -- tools/roc_build.shale keeps it, so no release build is waited for.
    local driver = built_roc(WHO, JS_X86_APP, "js-x86", "dev")
    for c in compilers do c.driver = driver end
  end
  if has_key(parts, "bytes") then part_bytes(compilers) end
  if has_key(parts, "build") then part_build(compilers, runs) end
  if has_key(parts, "speed") then part_speed(compilers, runs) end
  if has_key(parts, "build") or has_key(parts, "speed") or has_key(parts, "size") then part_summary(compilers) end
  part_same(compilers)
  return nil
end

main()
