-- budget: steps=900000000 arena_bytes=2000000000 output_bytes=200000 kept_bytes=100000000 machine_bytes=400000000
-- x86/cost.shale: the deterministic cost tier (x86/COST.md). Numbers that
-- come from the bytes alone, so the box's load can't move them. From the
-- repository's root:
--
--   shale x86/cost.shale                              # every race, this tree's js-x86: its bytes
--   shale x86/cost.shale races=sat --args-stdin <<'ARGS'
--   drivers=master:/path/master-js-x86,lane3:/path/lane3-js-x86
--   places=master:code_16_70-80,lane3:code_16_71-81
--   ARGS
--   shale x86/cost.shale twice=1 ...                  # the same tier run twice, held equal
--   shale x86/cost.shale counted=1 races=sat          # and each race's exact dynamic count
--   shale x86/cost.shale proof=1                      # the counter held to a loop's counts, by hand
--
-- Three parts:
--   - **The bytes.** Each race (fib at N = 100,000, bank at 2,000,000
--     transfers, fourteen and big daddy at 300 rounds, the SAT race at its
--     small workload: x86/collector.shale's sizes) compiled by each driver:
--     the executable's size, its code's static instruction count (objdump),
--     and whether its bytes are the first driver's. Two drivers that write
--     the same bytes for a race run the same program: any time between them
--     is the box's.
--   - **The places.** For each driver with `places=` (a bytecode range of
--     one function, `code_<f>_<from>-<to>`, its own for each driver label,
--     since a versioned loop renumbers them), the fast path of each
--     bytecode instruction in the range (from its label to its first `jmp`
--     or the next label: its own `_slow` or `_read_exit`, or the next place's),
--     joined in order, read by llvm-mca for the box's CPU (`mcpu=`,
--     cascadelake: family 6, model 85, stepping 7): its instructions, its
--     micro-ops, its block reciprocal throughput (the cycles a pass needs
--     if passes overlap freely) and its one-pass latency (one iteration's
--     cycles from the first dispatch to the last retire: the dependency
--     chains) twice: `latency` with each load after every store before it
--     (`-noalias=false`, so a value spilled to the frame and loaded back
--     costs its trip, and so does every other frame load: a ceiling) and
--     `free` with none (`-noalias=true`: a floor). The hardware forwards a
--     store to a load of its own address and lets others pass, so it lies
--     between.
--     `show=1` writes the fast path and llvm-mca's timeline of the pass
--     beside the executable, and names the file.
--   - **The counts** (`counted=1`). The box has no tool that counts a run's
--     instructions (no valgrind, no PMU in the VM, perf_event_paranoid 4),
--     so the executable counts its own: js-x86's `counted` mode
--     (x86/roc/Counter.roc) puts a counter at each block's start and writes
--     `x86.counts`, and `countmap` says where each block starts in the
--     uncounted code, which is the race's, byte for byte. Each block's count
--     times its static instructions (objdump, of a copy whose data is
--     `nop`s, so the disassembly stays in step) is what it ran: per place
--     (`code_<f>_<n>` or a runtime routine), per function, in the program's
--     code (`code_*`) and in the runtime, and in all. It stops unless the
--     count is exact: every `j..` and `call` to a known target lands on a
--     block's start, and every instruction after a `j..` or a `ret` starts
--     one. Each block's count times llvm-mca's block reciprocal throughput
--     for it, summed, is `predicted_cycles`: a model that lets blocks
--     overlap freely within themselves and not across them, and knows no
--     cache. The counted executable runs in a folder of its own, its output
--     and exit held to the race's; it runs about 3 to 10 times as long,
--     one memory increment a block.
--     `proof=1` is the counter's own check, in check.shale: a loop of 10,
--     20 and 30 trips, its head held to trips + 1 runs, its body to trips,
--     and the program's code to one trip's static instructions more for
--     each trip.
-- llvm-mca only reads our bytes' disassembly; nothing of LLVM enters the
-- compiler.

use("./executables.shale")

const WHO = "x86/cost.shale"
const CODE_START = 4194424
const WANT_OBJDUMP = "x86: the compiled race read back for its cost"
const WANT_MCA = "x86: llvm-mca reads our bytes' disassembly, outside the compiler, for the cost tier"

function set_const(text, name, value)
  local pattern = "\nconst " .. name .. " = [^;\n]+;"
  if re_find(text, pattern) == nil then fail(WHO .. ": no line `const " .. name .. " = ...;` to set") end
  return re_replace(text, pattern, "\nconst " .. name .. " = " .. value .. ";")
end

-- Each race asked for: `{name, size, text}`, at collector.shale's sizes.
function races(names)
  local fixed = {
    fib = {path = "x86/race/fib_race.js", line = "N", value = "100000"},
    bank = {path = "x86/bank/bank_race.js", line = "TRANSFERS", value = "2000000"},
    fourteen = {path = "x86/fourteen/fourteen.js", line = "ROUNDS", value = "300"},
    bigdaddy = {path = "x86/bigdaddy/bigdaddy_race.js", line = "ROUNDS", value = "300"},
    sat = {path = "x86/satrace/sat.js", line = "WORKLOAD", value = "\"small\""},
  }
  local out = {}
  for name in split(names, ",") do
    if not has_key(fixed, name) then fail(WHO .. ": no race named " .. name .. ": fib, bank, fourteen, bigdaddy or sat") end
    local f = fixed[name]
    push(out, {name = name, size = re_replace(f.value, "\"", ""), text = set_const(read(f.path), f.line, f.value)})
  end
  return out
end

-- The drivers: `{label, exe}`, this tree's own unless `drivers=` names some.
function drivers(named)
  if named == "" then return {{label = "this tree", exe = built_roc(WHO, "x86/roc/JsToX86.roc", "js-x86", "dev")}} end
  local out = {}
  for item in split(named, ",") do
    local m = re_find(item, "^([^:]+):(.+)$")
    if m == nil then fail(WHO .. ": a driver is `label:path`, not " .. item) end
    push(out, {label = m.groups[1], exe = m.groups[2]})
  end
  return out
end

-- `places=`: a map from a driver's label to `{f, from, to}`.
function places_of(named)
  local out = {}
  if named == "" then return out end
  for item in split(named, ",") do
    local m = re_find(item, "^([^:]+):code_([0-9]+)_([0-9]+)-([0-9]+)$")
    if m == nil then fail(WHO .. ": a place range is `label:code_<f>_<from>-<to>`, not " .. item) end
    out[m.groups[1]] = {f = tonumber(m.groups[2]), from = tonumber(m.groups[3]), to = tonumber(m.groups[4])}
  end
  return out
end

-- The number lowercase hex digits spell.
function unhex(s)
  local digits = "0123456789abcdef"
  local n = 0
  for i = 1, #s do n = n * 16 + find(digits, sub(s, i, i)) - 1 end
  return n
end

-- The disassembly's instructions as `{at, text}`, `at` from the code's start.
function instructions_of(path)
  local d = run({"objdump", "-D", "-b", "binary", "-mi386:x86-64", "-M", "intel", "--adjust-vma=0x400000", "--start-address=0x400078", real(path)}, {timeout_ms = 120000, whole = 200000000, want = WANT_OBJDUMP})
  if d.code ~= 0 then fail(WHO .. ": objdump exited " .. d.code) end
  local out = {}
  for l in lines(d.out) do
    local m = re_find(l, "^ *([0-9a-f]+):\t[0-9a-f ]+\t(.*)$")
    if m ~= nil then push(out, {at = unhex(m.groups[1]) - CODE_START, text = trim(m.groups[2])}) end
  end
  return out
end

-- The labels of function `f` as `{at, label}`, sorted by offset.
function labels_of(exe, text, f)
  local made = driver_run(exe, text, "labels")
  if made.code ~= 0 then fail(WHO .. ": js-x86 labels exited " .. made.code .. ": " .. trim(made.out)) end
  local rows = {}
  local prefix = "code_" .. f .. "_"
  for l in lines(made.out) do
    if find(l, prefix) ~= nil then
      local m = re_find(l, "^([0-9]+) (code_[0-9]+_.*)$")
      if m ~= nil and starts_with(m.groups[2], prefix) then push(rows, {at = tonumber(m.groups[1]), label = m.groups[2]}) end
    end
  end
  sort(rows, "at")
  return rows
end

-- The fast path of places `from` to `to` of function `f`: each place's
-- instructions from its label to its first `jmp` or the next label (its
-- own, `_slow`, or the next place's: an empty place's label shares its
-- next one's address), in order. `{lines, count}`.
function fast_path(instructions, rows, place)
  local start = {}
  local own = {}
  for r in rows do
    local m = re_find(r.label, "^code_[0-9]+_([0-9]+)(.*)$")
    if m ~= nil and m.groups[2] == "" then start[m.groups[1]] = r.at end
    if m ~= nil and m.groups[2] ~= "_start" then push(own, r.at) end
  end
  local index = {}
  for k = 1, #instructions do index["" .. instructions[k].at] = k end
  local out = {}
  for n = place.from, place.to do
    local at = get(start, "" .. n, -1)
    if at < 0 then fail(WHO .. ": no label code_" .. place.f .. "_" .. n) end
    local stop = 1000000000
    for o in own do if o > at and o < stop then stop = o end end
    local k = get(index, "" .. at, 0)
    if k == 0 then fail(WHO .. ": code_" .. place.f .. "_" .. n .. " is at no instruction's start") end
    while k <= #instructions and instructions[k].at < stop and not starts_with(instructions[k].text, "jmp") do
      push(out, instructions[k].text)
      k = k + 1
    end
  end
  return out
end

-- An instruction as llvm-mc reads it: a branch's absolute target made a
-- label, objdump's `QWORD PTR` kept (Intel syntax).
function mca_line(t)
  local m = re_find(t, "^(j[a-z]+|call) +0x[0-9a-f]+")
  if m ~= nil then return m.groups[1] .. " .Lout" end
  return t
end

-- llvm-mca's reading of the file's pass, loads after every store before
-- them (`alias`) or after none: `{instructions, uops, rthroughput, latency,
-- out}`.
function mca_run(file, cpu, alias, show)
  local argv = {"llvm-mca-18", "-mtriple=x86_64", "-mcpu=" .. cpu, "-noalias=" .. (alias and "false" or "true"), "-iterations=1"}
  if show then push(argv, "-timeline") push(argv, "-timeline-max-cycles=0") end
  push(argv, real(file))
  local r = run(argv, {timeout_ms = 60000, whole = 4000000, want = WANT_MCA})
  if r.code ~= 0 then fail(WHO .. ": llvm-mca exited " .. r.code .. ": " .. sub(r.out, 1, 2000)) end
  if find(r.out, "error:") ~= nil then fail(WHO .. ": llvm-mca refused a line: " .. sub(r.out, 1, 2000)) end
  local n = re_find(r.out, "Instructions: +([0-9]+)")
  local cycles = re_find(r.out, "Total Cycles: +([0-9]+)")
  local uops = re_find(r.out, "Total uOps: +([0-9]+)")
  local rt = re_find(r.out, "Block RThroughput: +([0-9.]+)")
  return {instructions = n.group, latency = cycles.group, uops = uops.group, rthroughput = rt.group, out = r.out}
end

-- llvm-mca's reading of a fast path: its instructions, micro-ops and block
-- throughput, its one-pass latency both ways (`latency` with every load
-- after the stores before it, `free` with none), and the first's timeline.
function mca(path_lines, cpu, file, show)
  local src = {".intel_syntax noprefix"}
  for t in path_lines do push(src, mca_line(t)) end
  push(src, ".Lout:")
  replace(file, join(src, "\n") .. "\n")
  local held = mca_run(file, cpu, true, show)
  local free = mca_run(file, cpu, false, false)
  held.free = free.latency
  return held
end

-- ── The counts (x86/COST.md, "The counter") ──────────────────────────────

-- Every label of the program's code as `{at, label}`, sorted by offset.
function all_labels(exe, text)
  local made = driver_run(exe, text, "labels")
  if made.code ~= 0 then fail(WHO .. ": js-x86 labels exited " .. made.code .. ": " .. trim(made.out)) end
  local rows = {}
  for l in lines(made.out) do
    local m = re_find(l, "^([0-9]+) (.+)$")
    if m ~= nil then push(rows, {at = tonumber(m.groups[1]), label = m.groups[2]}) end
  end
  sort(rows, "at")
  return rows
end

-- js-x86's `countmap`: `{points, kept, bounds}`, `points` each counter's
-- `{k, at, kind, flags}` in counter order (`k` from 1), `bounds` every
-- block's start and every piece of data's, `{at, k}` (`k` 0 for data),
-- sorted by offset.
function count_map(exe, text)
  local made = driver_run(exe, text, "countmap")
  if made.code ~= 0 then fail(WHO .. ": js-x86 countmap exited " .. made.code .. ": " .. trim(made.out)) end
  local points = {}
  local bounds = {}
  local kept = 0
  for l in lines(made.out) do
    local w = words(l)
    if #w > 0 and w[1] == "point" then
      local p = {k = tonumber(w[2]) + 1, at = tonumber(w[3]), kind = w[4], flags = w[6]}
      if p.flags == "kept" then kept = kept + 1 end
      push(points, p)
      push(bounds, {at = p.at, k = p.k})
    elseif #w > 0 and w[1] == "data" then
      push(bounds, {at = tonumber(w[2]), k = 0})
    end
  end
  sort(bounds, "at")
  return {points = points, kept = kept, bounds = bounds}
end

-- The counts the counted executable wrote, a list beside the points: 8
-- bytes each, read by `od` (unsigned 64-bit words, every line, `-v`).
function counts_of(file, n)
  local r = run({"od", "-A", "n", "-v", "-t", "u8", real(file)}, {timeout_ms = 120000, whole = 100000000})
  if r.code ~= 0 then fail(WHO .. ": od exited " .. r.code) end
  local out = {}
  for l in lines(r.out) do
    for w in words(l) do push(out, tonumber(w)) end
  end
  if #out ~= n then fail(WHO .. ": " .. file .. " holds " .. #out .. " counts, not the map's " .. n) end
  return out
end

-- The counted executable for `race`, run in a folder of its own beside
-- `path`: `{counts, raw}`, `raw` the counts' file's bytes. What it prints
-- and its exit are held to the uncounted executable's.
function counted_run(race, d, path, n)
  local folder = path .. ".counted"
  mkdir(folder)
  local made = driver_run(d.exe, race.text, "counted")
  if made.code ~= 0 then fail(WHO .. ": js-x86 counted exited " .. made.code .. ": " .. trim(made.out)) end
  local exe = folder .. "/" .. basename(path)
  hex_written(WHO, made.out, exe)
  local file = folder .. "/x86.counts"
  if exists(file) then remove(file) end
  local r = run({real(exe)}, {cwd = folder, timeout_ms = 600000, whole = 4000000, want = WANT_BINARY, nice = 19})
  local plain = run({real(path)}, {timeout_ms = 600000, whole = 4000000, want = WANT_BINARY, nice = 19})
  if r.code ~= plain.code or r.out ~= plain.out then fail(WHO .. ": " .. race.name .. ": the counted executable printed or exited otherwise than the race's (exit " .. r.code .. " against " .. plain.code .. ")") end
  return {counts = counts_of(file, n), raw = read(file)}
end

-- The block each instruction is in: a list beside `instructions`, each the
-- counter's `k` or 0 for data. The count is exact only when every way into
-- the code is a counter's start, so this stops unless each block's start
-- and each piece of data begins an instruction, each `j..` and `call` to a
-- known target lands on a block's start, and each instruction after a
-- `j..` or a `ret` begins a block or data.
function blocks_of(instructions, map)
  local starts = {}
  for p in map.points do starts["" .. p.at] = true end
  local bounded = {}
  for b in map.bounds do bounded["" .. b.at] = true end
  local out = {}
  local j = 0
  local block = 0
  local after_branch = false
  for i in instructions do
    while j < #map.bounds and map.bounds[j + 1].at <= i.at do
      j = j + 1
      if map.bounds[j].at < i.at then fail(WHO .. ": a block's start, at " .. map.bounds[j].at .. ", is inside the instruction at " .. i.at .. " (" .. i.text .. ")") end
      block = map.bounds[j].k
    end
    if after_branch and not has_key(bounded, "" .. i.at) then fail(WHO .. ": the instruction at " .. i.at .. " (" .. i.text .. ") follows a jump and starts no block") end
    push(out, block)
    after_branch = false
    if block ~= 0 then
      local m = re_find(i.text, "^(j[a-z]+|call) +0x([0-9a-f]+)")
      if m ~= nil then
        local target = unhex(m.groups[2]) - CODE_START
        if not has_key(starts, "" .. target) then fail(WHO .. ": `" .. i.text .. "` at " .. i.at .. " lands where no block starts") end
      end
      if re_find(i.text, "^(j[a-z]+|ret)") ~= nil then after_branch = true end
    end
  end
  if j ~= #map.bounds then fail(WHO .. ": " .. (#map.bounds - j) .. " block starts lie past the code") end
  return out
end

-- The last label of `rows` holding `pattern` at or before each offset of
-- `instructions`: a list beside them.
function labels_over(instructions, rows, pattern)
  local kept = {}
  for r in rows do
    if re_find(r.label, pattern) ~= nil then push(kept, r) end
  end
  local out = {}
  local k = 0
  for i in instructions do
    while k < #kept and kept[k + 1].at <= i.at do k = k + 1 end
    if k == 0 then push(out, "(the start)") else push(out, kept[k].label) end
  end
  return out
end

-- The hundredths llvm-mca's `3.5` or `12` spells.
function hundredths_of(s)
  local m = re_find(s, "^([0-9]+)\\.?([0-9]*)$")
  if m == nil then fail(WHO .. ": llvm-mca's throughput " .. s .. " is no number") end
  local digits = sub(m.groups[2] .. "00", 1, 2)
  return tonumber(m.groups[1]) * 100 + tonumber(digits)
end

-- Each run block's block reciprocal throughput, in hundredths of a cycle,
-- from one llvm-mca run over the blocks as its code regions: a map from
-- the counter's `k`, as a string.
function block_throughputs(instructions, blocks, counts, cpu, file)
  local src = {".intel_syntax noprefix"}
  local order = {}
  local open = 0
  for n = 1, #instructions do
    local k = blocks[n]
    if k ~= open then
      if open ~= 0 then push(src, "# LLVM-MCA-END") end
      open = 0
      if k ~= 0 and counts[k] > 0 then
        push(src, "# LLVM-MCA-BEGIN b" .. k)
        push(order, k)
        open = k
      end
    end
    if open ~= 0 then push(src, mca_line(instructions[n].text)) end
  end
  if open ~= 0 then push(src, "# LLVM-MCA-END") end
  push(src, ".Lout:")
  replace(file, join(src, "\n") .. "\n")
  -- The report goes to a file of its own, so llvm-mca's warnings on
  -- stderr (a call, a `ret`) can't land inside it.
  local report = file .. ".mca.txt"
  local r = run({"llvm-mca-18", "-mtriple=x86_64", "-mcpu=" .. cpu, "-iterations=1", "-instruction-info=false", "-resource-pressure=false", "-o", real(report), real(file)}, {timeout_ms = 300000, whole = 4000000, want = WANT_MCA})
  if r.code ~= 0 then fail(WHO .. ": llvm-mca exited " .. r.code .. ": " .. sub(r.out, 1, 2000)) end
  if find(r.out, "error:") ~= nil then fail(WHO .. ": llvm-mca refused a line: " .. sub(r.out, 1, 2000)) end
  local rts = re_find_all(read(report), "Block RThroughput: +([0-9.]+)")
  if #rts ~= #order then fail(WHO .. ": llvm-mca read " .. #rts .. " regions, not the " .. #order .. " blocks run") end
  local out = {}
  for n = 1, #order do out["" .. order[n]] = hundredths_of(rts[n].groups[1]) end
  return out
end

-- `n` bytes of `nop` (0x90).
function nops(n)
  local out = ""
  local piece = "\x90"
  local left = n
  while left > 0 do
    if left % 2 == 1 then out = out .. piece end
    piece = piece .. piece
    left = left // 2
  end
  return out
end

-- The uncounted executable's instructions, read by objdump from a copy
-- whose data (each piece from its start to the next block's) is `nop`s, so
-- the disassembly can't run out of step at the code after the data.
function code_instructions(path, map)
  local bytes = read(path)
  local head = CODE_START - 4194304
  local pieces = {}
  local from = 1
  for n = 1, #map.bounds do
    local b = map.bounds[n]
    if b.k == 0 then
      local stop = #bytes - head
      if n < #map.bounds then stop = map.bounds[n + 1].at end
      push(pieces, sub(bytes, from, head + b.at))
      push(pieces, nops(stop - b.at))
      from = head + stop + 1
    end
  end
  push(pieces, sub(bytes, from, #bytes))
  local copy = path .. ".code"
  replace(copy, join(pieces, ""))
  if stat(copy).size ~= #bytes then fail(WHO .. ": the copy of " .. path .. " is " .. stat(copy).size .. " bytes, not " .. #bytes) end
  return instructions_of(copy)
end

-- The counts of one driver's race: its row of the counts table, the
-- instructions run by place and by function, and the counts' bytes.
function counted(race, d, path, cpu)
  local map = count_map(d.exe, race.text)
  local instructions = code_instructions(path, map)
  local ran = counted_run(race, d, path, #map.points)
  local blocks = blocks_of(instructions, map)
  local rows = all_labels(d.exe, race.text)
  local places = labels_over(instructions, rows, "^(code_[0-9]+_[0-9]+|runtime_[a-z_0-9]+)$")
  local functions = labels_over(instructions, rows, "^(code_[0-9]+|runtime_[a-z_0-9]+)$")
  local rt = block_throughputs(instructions, blocks, ran.counts, cpu, path .. ".blocks.s")
  local total = 0
  local program = 0
  local by_place = {}
  local by_function = {}
  for n = 1, #instructions do
    local k = blocks[n]
    if k ~= 0 then
      local c = ran.counts[k]
      if c > 0 then
        total = total + c
        if starts_with(functions[n], "code_") then program = program + c end
        by_place[places[n]] = get(by_place, places[n], 0) + c
        by_function[functions[n]] = get(by_function, functions[n], 0) + c
      end
    end
  end
  local cycles = 0
  for k in keys(rt) do cycles = cycles + ran.counts[tonumber(k)] * rt[k] end
  local row = {race = race.name .. " " .. race.size, driver = d.label, blocks = #map.points, kept = map.kept, instructions_run = total, in_program = program, in_runtime = total - program, predicted_cycles = (cycles + 50) // 100}
  return {row = row, by_place = by_place, by_function = by_function, total = total, program = program, raw = ran.raw, blocks = blocks, counts = ran.counts, labels = rows, instructions = instructions}
end

-- The `top` largest of a map of counts, as rows with their share.
function top_rows(by, total, top)
  local rows = {}
  for k in keys(by) do push(rows, {name = k, n = by[k]}) end
  sort(rows, "n", "desc")
  local out = {}
  for i = 1, #rows do
    if i <= top then
      local tenths = (rows[i].n * 1000 + total // 2) // total
      push(out, {name = rows[i].name, instructions = rows[i].n, share = (tenths // 10) .. "." .. (tenths % 10) .. "%"})
    end
  end
  return out
end

-- One driver's race: its row of the bytes, and its row of the places (or
-- false) with llvm-mca's text when `show` (else false). `first` is the first driver's
-- executable's path, or nil for the first.
function one(race, i, d, dir, places, cpu, show, first, count, top)
  local path = dir .. "/" .. race.name .. "-" .. i
  local size = written_executable(WHO, d.exe, race.text, path)
  local same = "yes"
  if first ~= nil and read(path) ~= read(first) then same = "no" end
  local instructions = instructions_of(path)
  local out = {path = path, bytes = {race = race.name .. " " .. race.size, driver = d.label, bytes = size, code_instructions = #instructions, same = same}, place = false, shown = false}
  if has_key(places, d.label) and race.name == "sat" then
    local place = places[d.label]
    local rows = labels_of(d.exe, race.text, place.f)
    local fp = fast_path(instructions, rows, place)
    local m = mca(fp, cpu, path .. ".mca.s", show)
    out.place = {driver = d.label, places = "code_" .. place.f .. "_" .. place.from .. "-" .. place.to, instructions = m.instructions, uops = m.uops, rthroughput = m.rthroughput, latency = m.latency, free = m.free}
    if show then
      replace(path .. ".mca.txt", join(fp, "\n") .. "\n\n" .. m.out)
      out.shown = d.label .. ": the fast path and llvm-mca's timeline in " .. real(path) .. ".mca.txt"
    end
  end
  out.count = false
  if count then
    local c = counted(race, d, path, cpu)
    local all = top_rows(c.by_place, c.total, 1000000)
    replace(path .. ".places.txt", table(all, {"name", "instructions", "share"}) .. "\n")
    out.count = {row = c.row, raw = c.raw, places = top_rows(c.by_place, c.total, top), functions = top_rows(c.by_function, c.total, top), file = real(path) .. ".places.txt"}
  end
  return out
end

-- One pass of the tier: its tables' text, and with `count` each race's
-- counts' bytes, in order.
function tier(list, ds, places, cpu, show, count, top)
  local dir = executables_dir() .. "/cost"
  mkdir(dir)
  local bytes_rows = {}
  local place_rows = {}
  local count_rows = {}
  local tops = {}
  local raws = {}
  local shown = {}
  for race in list do
    local first = nil
    for i = 1, #ds do
      local o = one(race, i, ds[i], dir, places, cpu, show, first, count, top)
      if first == nil then first = o.path end
      push(bytes_rows, o.bytes)
      if o.place then push(place_rows, o.place) end
      if o.shown then push(shown, o.shown) end
      if o.count then
        push(count_rows, o.count.row)
        push(raws, o.count.raw)
        push(tops, "── " .. o.count.row.race .. ", " .. o.count.row.driver .. ": the functions, then the places, that ran the most instructions (every place in " .. o.count.file .. ")\n" .. table(o.count.functions, {"name", "instructions", "share"}) .. "\n" .. table(o.count.places, {"name", "instructions", "share"}))
      end
      yield()
    end
  end
  local text = table(bytes_rows, {"race", "driver", "bytes", "code_instructions", "same"})
  if #place_rows > 0 then text = text .. "\n" .. table(place_rows, {"driver", "places", "instructions", "uops", "rthroughput", "latency", "free"}) end
  if #count_rows > 0 then text = text .. "\n" .. table(count_rows, {"race", "driver", "blocks", "kept", "instructions_run", "in_program", "in_runtime", "predicted_cycles"}) .. "\n" .. join(tops, "\n") end
  return {text = text, shown = shown, raws = raws}
end

-- ── The proof: a loop whose counts are known by hand ──────────────────────

const LOOP = "let s = 0;\nfor (let i = 0; i < TRIPS; i++) { s = s + i; }\nconsole.log(s);\n"

-- The loop of `trips` trips, counted: `{trips, head, body, once, per_trip,
-- program}`. The top level's code (`code_0`) holds one jump back, the loop's
-- `jmp` to its head, and one jump out of the loop, the head's `j..` past
-- that `jmp`; by hand, the head's block runs `trips + 1` times, the block
-- after the jump out `trips` times, and a trip is the instructions from the
-- head through the `jmp`.
function loop_counted(d, dir, trips, cpu)
  local race = {name = "loop", size = "" .. trips, text = re_replace(LOOP, "TRIPS", "" .. trips)}
  local path = dir .. "/loop-" .. trips
  written_executable(WHO, d.exe, race.text, path)
  local c = counted(race, d, path, cpu)
  local instructions = c.instructions
  local from = -1
  local to = -1
  for r in c.labels do
    if r.label == "code_0" then from = r.at end
    if from >= 0 and to < 0 and r.at > from and re_find(r.label, "^(code_[0-9]+|runtime_[a-z_0-9]+)$") ~= nil then to = r.at end
  end
  if from < 0 or to < 0 then fail(WHO .. ": proof: no code_0 and a label after it") end
  local back = {}
  for n = 1, #instructions do
    local i = instructions[n]
    local m = re_find(i.text, "^jmp +0x([0-9a-f]+)")
    if i.at >= from and i.at < to and m ~= nil and unhex(m.groups[1]) - CODE_START < i.at then push(back, {n = n, target = unhex(m.groups[1]) - CODE_START}) end
  end
  if #back ~= 1 then fail(WHO .. ": proof: code_0 holds " .. #back .. " jumps back, not the loop's one") end
  local head = 0
  for n = 1, #instructions do if instructions[n].at == back[1].target then head = n end end
  local out = 0
  for n = head, back[1].n do
    local m = re_find(instructions[n].text, "^j[a-z]+ +0x([0-9a-f]+)")
    if m ~= nil and n < back[1].n and unhex(m.groups[1]) - CODE_START > instructions[back[1].n].at then
      if out ~= 0 then fail(WHO .. ": proof: the loop has two jumps out") end
      out = n
    end
  end
  if out == 0 then fail(WHO .. ": proof: the loop has no jump out") end
  return {trips = trips, head = c.counts[c.blocks[head]], body = c.counts[c.blocks[out + 1]], per_trip = back[1].n - head + 1, program = c.program, total = c.total}
end

-- The counter held to a loop's counts worked out by hand, at 10, 20 and 30
-- trips: the head runs one time more than the trips, the body once a trip,
-- and each 10 trips more run the program's code exactly 10 trips' static
-- instructions more.
function proof(d, cpu)
  local dir = executables_dir() .. "/cost"
  mkdir(dir)
  local runs = {}
  for trips in {10, 20, 30} do push(runs, loop_counted(d, dir, trips, cpu)) end
  for r in runs do
    if r.head ~= r.trips + 1 then fail(WHO .. ": proof: the head of a loop of " .. r.trips .. " trips ran " .. r.head .. " times, not " .. (r.trips + 1)) end
    if r.body ~= r.trips then fail(WHO .. ": proof: the body of a loop of " .. r.trips .. " trips ran " .. r.body .. " times") end
    if r.per_trip ~= runs[1].per_trip then fail(WHO .. ": proof: the loop's code differs between the sizes") end
  end
  for n = 2, #runs do
    local grew = runs[n].program - runs[n - 1].program
    local want = (runs[n].trips - runs[n - 1].trips) * runs[1].per_trip
    if grew ~= want then fail(WHO .. ": proof: the program's code ran " .. grew .. " instructions more at " .. runs[n].trips .. " trips than at " .. runs[n - 1].trips .. ", not the " .. want .. " of 10 trips of " .. runs[1].per_trip) end
  end
  local once = runs[1].program - 10 * runs[1].per_trip
  if runs[3].program ~= once + 30 * runs[1].per_trip then fail(WHO .. ": proof: the program's code is not linear in the trips") end
  for r in runs do print("loop of " .. r.trips .. " trips: head " .. r.head .. ", body " .. r.body .. ", program's code " .. r.program .. " = " .. once .. " + " .. r.trips .. " x " .. r.per_trip .. ", in all " .. r.total) end
  print("proof: the counts are the loop's, worked out by hand")
end

function main()
  if arg("proof", false) then
    proof(drivers("")[1], arg("mcpu", "cascadelake"))
    return nil
  end
  local list = races(arg("races", "fib,bank,fourteen,bigdaddy,sat"))
  local ds = drivers(arg("drivers", ""))
  local places = places_of(arg("places", ""))
  local cpu = arg("mcpu", "cascadelake")
  local show = arg("show", false)
  local count = arg("counted", false)
  local top = arg("top", 8)
  local first = tier(list, ds, places, cpu, show, count, top)
  print(first.text)
  for s in first.shown do print(s) end
  if arg("twice", false) then
    local second = tier(list, ds, places, cpu, false, count, top)
    if second.text ~= first.text then fail(WHO .. ": the second pass differs:\n" .. second.text) end
    for n = 1, #first.raws do
      if second.raws[n] ~= first.raws[n] then fail(WHO .. ": the second pass's counts' file " .. n .. " differs from the first's") end
    end
    print("twice: the second pass's tables are the first's, byte for byte")
    if count then print("twice: and each of the " .. #first.raws .. " x86.counts files is the first's, byte for byte") end
  end
end

main()
