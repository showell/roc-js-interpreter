-- This library carries the x86-64 backend's executables from the Roc that
-- writes them to the disk, for x86/'s scripts: hello.shale, fib.shale and
-- programs.shale. Roc's default platform writes only text to stdout, so a
-- driver prints an executable's bytes as hex (X86.hex_text's two lowercase
-- digits a byte, a space between), and `bytes_of_hex` turns each pair back
-- into its byte, by a map from each of the 256 pairs to its byte of BYTES,
-- a string holding every byte from 0 to 255 in order. It decides none of
-- them: every byte of the file is the Roc's.
--
-- Each script names it as `use("./executables.shale")`.

const BYTES = "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"
const HEX_DIGITS = "0123456789abcdef"
const WANT_ROC = "roc-pin: the repository's pinned nightly"
const WANT_DRIVER = "x86: the backend's driver, built here"
const WANT_BINARY = "x86: an executable the Roc wrote, run to check it"
const WANT_NODE = "node: the oracle the compiled programs are held to"

-- Each of the 256 pairs of lowercase hex digits, mapped to its byte.
function byte_of_pair()
  if #BYTES ~= 256 then fail("x86/executables.shale: BYTES holds " .. #BYTES .. " bytes, not 256") end
  local out = {}
  for high = 1, 16 do
    for low = 1, 16 do
      local n = (high - 1) * 16 + low
      out[sub(HEX_DIGITS, high, high) .. sub(HEX_DIGITS, low, low)] = sub(BYTES, n, n)
    end
  end
  return out
end

-- The bytes the hex text `spaced` spells, two lowercase digits a byte and a
-- space between bytes. Its pieces between spaces are looked up whole, so a
-- piece that is not a pair of lowercase hex digits (an odd digit, a capital,
-- a newline, two spaces) is found by the lookup, with no pattern over the
-- whole text.
function bytes_of_hex(who, spaced)
  if spaced == "" then return "" end
  local byte_of = byte_of_pair()
  local parts = {}
  for pair in split(spaced, " ") do
    local b = get(byte_of, pair, "")
    if b == "" then fail(who .. ": the driver printed something that is not spaced lowercase hex: " .. json_write(sub(pair, 1, 40)) .. " at byte " .. (#parts + 1) .. " of " .. sub(spaced, 1, 200)) end
    push(parts, b)
  end
  return join(parts, "")
end

-- The folder this checkout's executables are written to, under the build
-- mount.
function executables_dir()
  local dir = "build:roc-js-interpreter/x86/" .. basename(real("."))
  mkdir(dir)
  return dir
end

-- The number of expects `roc test` ran and passed from `root`, a file of
-- x86/roc, or a stop.
function expects_passed(who, root)
  local roc = pinned_roc(who)
  local r = run({roc, "test", root}, {cwd = "x86/roc", timeout_ms = 300000, tail = 40, want = WANT_ROC, nice = 19})
  local m = re_find(r.out, "All \\(([0-9]+)\\) tests passed")
  if r.code ~= 0 or m == nil then fail(who .. ": roc test x86/roc/" .. root .. " failed:\n" .. trim(r.out)) end
  return tonumber(m.group)
end

-- What a driver run printed and how it ended: `{code, out}`, the code -1
-- when it didn't exit. `mode`, when given, is the driver's second argument
-- (js-x86's `inlined`).
function driver_run(exe, argument, mode?)
  local argv = {exe, argument}
  if mode ~= nil then push(argv, mode) end
  local r = run(argv, {timeout_ms = 60000, whole = 4000000, want = WANT_DRIVER})
  if r.ended ~= "exit" then return {code = -1, out = r.out} end
  return {code = r.code, out = r.out}
end

-- The executable the driver at `exe` writes for `argument`, written to
-- `path` and made executable; its size in bytes. A driver that fails stops
-- the run with what it printed.
function written_executable(who, exe, argument, path)
  local made = driver_run(exe, argument)
  if made.code ~= 0 then fail(who .. ": the driver exited " .. made.code .. ": " .. trim(made.out)) end
  local binary = bytes_of_hex(who, made.out)
  replace(path, binary)
  must(run({"chmod", "755", real(path)}, {timeout_ms = 10000, whole = 4000}))
  return #binary
end

-- An executable's run: `{ended, code, out, ms, cpu_ms}`, stdout and stderr
-- together, the code -1 when it didn't exit. `argument`, when given, is the
-- executable's first argument: `heapwalk` walks the heap at its exit and at
-- a stop, every block's header checked (x86/roc/Heap.roc), and prints
-- nothing more unless a header is wrong.
function executable_run(path, argument?)
  local argv = {real(path)}
  if argument ~= nil then push(argv, argument) end
  local r = run(argv, {timeout_ms = 60000, whole = 1000000, want = WANT_BINARY})
  return {ended = r.ended, code = get(r, "code", -1), out = r.out, ms = r.ms, cpu_ms = r.cpu_ms}
end

-- node's run of the program at `path`, the oracle: `{code, out, ms, cpu_ms}`.
function node_run(path)
  local r = run({"node", real(path)}, {timeout_ms = 60000, whole = 1000000, want = WANT_NODE})
  return {code = get(r, "code", -1), out = r.out, ms = r.ms, cpu_ms = r.cpu_ms}
end
