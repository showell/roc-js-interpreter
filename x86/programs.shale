-- budget: steps=132000000
-- x86/programs.shale: the x86-64 backend's programs, each held to node or to
-- its refusal. From the repository's root:
--
--   shale x86/programs.shale
--
-- It builds js-x86 on the dev backend, then:
--   - each program in x86/tests/ is compiled to a static executable under the
--     build mount and run, and what it printed and its exit code must be
--     node's for the same program, exactly;
--   - the call sites x86/roc/Inlining.roc puts in line across x86/tests/, and
--     the instructions their bodies place, must be INLINED exactly, so the
--     code's growth can't creep unseen; a program whose first line is
--     `// inlined: <sites> sites, <instructions> instructions` is held to
--     its own count too;
--   - each program in x86/tests/refused/ names in its first line what it must
--     come to: `// refused: <text>`, a line js-x86 prints as it exits 1
--     without writing an executable, or `// stops: <text>`, a line the
--     executable it writes prints as it exits 1 (a number console.log can't
--     write yet), where node would print the number;
--   - each program of the interpreter's corpus, js/tests/, is compiled and
--     run the same way, and the ones that print what node prints must be
--     exactly those x86/corpus.txt lists, one a line: a program that stops
--     matching fails, and so does one that starts to, until the list (and
--     the commit that moves it) says so.
-- Nothing is skipped: the run fails unless every program passes, and a
-- folder with no program in it fails too.
--
--   shale x86/programs.shale corpus=report
--
-- prints each corpus program's verdict and the reasons the rest fail,
-- grouped, and holds nothing.

use("./executables.shale")

const WHO = "x86/programs.shale"
const CORPUS = "x86/corpus.txt"
const REPORT = arg("corpus", "held") == "report"
-- The sites and instructions inlined across x86/tests/: a commit that moves
-- it says why.
const INLINED = "inlined: 47 sites, 683 instructions"

function js_files(dir)
  local out = {}
  for name in ls(dir) do
    if ends_with(name, ".js") then push(out, dir .. "/" .. name) end
  end
  sort(out)
  if #out == 0 then fail(WHO .. ": " .. dir .. " holds no program") end
  return out
end

-- The program's executable's name under the build mount: its folder's name
-- and its own, so two folders' programs never share one.
function executable_path(dir, js_path)
  return dir .. "/" .. re_replace(re_replace(js_path, "^x86/", ""), "[/.]", "-")
end

-- Why the program at `js_path` failed, or nil.
function held_to_node(exe, dir, js_path)
  local path = executable_path(dir, js_path)
  local made = driver_run(exe, read(js_path))
  if made.code ~= 0 then return "js-x86 exited " .. made.code .. ": " .. trim(made.out) end
  replace(path, bytes_of_hex(WHO, made.out))
  must(run({"chmod", "755", real(path)}, {timeout_ms = 10000, whole = 4000}))
  local r = executable_run(path)
  local n = node_run(js_path)
  if n.code ~= 0 then return "node exited " .. n.code .. ": " .. trim(n.out) end
  if r.ended ~= "exit" or r.code ~= 0 then return "the executable ended " .. r.ended .. " " .. r.code .. ": " .. trim(r.out) end
  if r.out ~= n.out then return "it printed " .. json_write(r.out) .. ", node " .. json_write(n.out) end
  return nil
end

-- What the driver says it inlined in the program at `js_path`: `{sites,
-- instructions}`, and why it differs from the count the program's first line holds,
-- or nil.
function inlined_count(exe, js_path)
  local said = trim(driver_run(exe, read(js_path), "inlined").out)
  local m = re_find(said, "^inlined: ([0-9]+) sites, ([0-9]+) instructions$")
  if m == nil then return {sites = 0, instructions = 0, why = "js-x86 inlined said " .. json_write(said)} end
  local counted = {sites = tonumber(m.groups[1]), instructions = tonumber(m.groups[2])}
  local held = re_find(lines(read(js_path))[1], "^// (inlined: .+)$")
  if held ~= nil and held.group ~= said then counted.why = "it inlined " .. json_write(said) .. ", its first line holds " .. json_write(held.group) end
  return counted
end

-- Why the refused program at `js_path` failed, or nil.
function held_to_refusal(exe, dir, js_path)
  local first = lines(read(js_path))[1]
  local refused = re_find(first, "^// refused: (.+)$")
  local stops = re_find(first, "^// stops: (.+)$")
  local made = driver_run(exe, read(js_path))
  if refused ~= nil then
    if made.code ~= 1 then return "js-x86 exited " .. made.code .. ", not 1" end
    local said = trim(made.out)
    if not starts_with(said, "js-x86: refused: ") or not contains(said, refused.group) then return "js-x86 said " .. json_write(said) .. ", not a refusal holding " .. json_write(refused.group) end
    return nil
  end
  if stops == nil then return "its first line is neither `// refused: <text>` nor `// stops: <text>`" end
  if made.code ~= 0 then return "js-x86 exited " .. made.code .. ": " .. trim(made.out) end
  local path = executable_path(dir, js_path)
  replace(path, bytes_of_hex(WHO, made.out))
  must(run({"chmod", "755", real(path)}, {timeout_ms = 10000, whole = 4000}))
  local r = executable_run(path)
  if r.ended ~= "exit" or r.code ~= 1 then return "the executable ended " .. r.ended .. " " .. r.code .. ", not exit 1" end
  local said = lines(trim(r.out))
  if #said == 0 or said[#said] ~= stops.group then return "the executable's last line is " .. json_write(trim(r.out)) .. ", not " .. json_write(stops.group) end
  return nil
end

-- The reason a corpus program fails, with the function and the instruction
-- taken out, so programs that fail alike group.
function reason_group(why)
  local r = re_replace(why, "^js-x86 exited 1: js-x86: refused: ", "refused: ")
  r = re_replace(r, "^refused: (the program|the function `[^`]*`)(, instruction [0-9]+)?: ", "refused: ")
  r = re_replace(r, "^js-x86 exited 1: js-x86: ", "front end: ")
  if starts_with(r, "node exited ") then r = "node exits nonzero (an error the program doesn't catch)" end
  if starts_with(r, "the executable ended exit 1: ") then
    local said = lines(sub(r, #"the executable ended exit 1: " + 1))
    r = "stops: " .. said[#said]
  end
  if starts_with(r, "it printed ") then r = "prints otherwise than node" end
  return r
end

-- The corpus's verdicts against CORPUS: a list of what is wrong, empty when
-- the programs that match node are those it lists.
function corpus_check(exe, dir)
  local listed = {}
  for l in lines(read(CORPUS)) do
    if trim(l) ~= "" and not starts_with(l, "#") then push(listed, trim(l)) end
  end
  local listed_set = set_of(listed)
  local wrong = {}
  local matched = {}
  local groups = {}
  local names = {}
  local all = js_files("js/tests")
  for p in all do
    local why = held_to_node(exe, dir, p)
    yield()
    local name = basename(p)
    if why == nil then
      push(matched, name)
      if not has_key(listed_set, name) then push(wrong, p .. ": it matches node, and " .. CORPUS .. " doesn't list it") end
    else
      local g = reason_group(why)
      push_at(groups, g, name)
      if has_key(listed_set, name) then push(wrong, p .. ": " .. why) end
    end
  end
  for name in listed do
    if not exists("js/tests/" .. name) then push(wrong, CORPUS .. " lists " .. name .. ", which js/tests/ doesn't hold") end
  end
  if REPORT then
    print("corpus: " .. #matched .. " of " .. #all .. " match node: " .. join(matched, " "))
    local rows = {}
    for g in keys(groups) do push(rows, {n = #groups[g], g = g}) end
    sort(rows, "n", "desc")
    for row in rows do print(row.n .. "  " .. row.g .. ": " .. join(groups[row.g], " ")) end
  end
  return {wrong = wrong, matched = #matched, all = #all}
end

function main()
  local exe = built_roc(WHO, "x86/roc/JsToX86.roc", "js-x86", "dev")
  local dir = executables_dir()
  local wrong = {}
  local held = js_files("x86/tests")
  local refused = js_files("x86/tests/refused")
  local sites = 0
  local instructions = 0
  for p in held do
    local why = held_to_node(exe, dir, p)
    if why ~= nil then push(wrong, p .. ": " .. why) end
    local counted = inlined_count(exe, p)
    if has_key(counted, "why") then push(wrong, p .. ": " .. counted.why) end
    sites = sites + counted.sites
    instructions = instructions + counted.instructions
    yield()
  end
  local inlined = "inlined: " .. sites .. " sites, " .. instructions .. " instructions"
  if inlined ~= INLINED then push(wrong, "x86/tests/: " .. inlined .. ", and INLINED holds " .. json_write(INLINED)) end
  for p in refused do
    local why = held_to_refusal(exe, dir, p)
    if why ~= nil then push(wrong, p .. ": " .. why) end
    yield()
  end
  if #wrong > 0 then fail(WHO .. ": " .. #wrong .. " of " .. (#held + #refused) .. " programs failed:\n" .. join(wrong, "\n")) end
  local corpus = corpus_check(exe, dir)
  if #corpus.wrong > 0 and not REPORT then fail(WHO .. ": the corpus differs from " .. CORPUS .. ":\n" .. join(corpus.wrong, "\n")) end
  print("x86/programs: " .. inlined .. " across x86/tests/")
  print("x86/programs: " .. #held .. " programs printed what node prints, " .. #refused .. " came to their refusals, and " .. corpus.matched .. " of the corpus's " .. corpus.all .. " match node, held exactly to " .. CORPUS)
end

main()
