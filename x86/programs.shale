-- budget: steps=180000000 arena_bytes=200000000 programs=1400
-- x86/programs.shale: the x86-64 backend's programs, each held to node or to
-- its refusal. From the repository's root:
--
--   shale x86/programs.shale
--
-- It builds js-x86 on the dev backend, then:
--   - each program in x86/tests/ is compiled to a static executable under the
--     build mount and run, and what it printed and its exit code must be
--     node's for the same program, exactly;
--   - the call sites x86/roc/Inlining.roc puts in line across x86/tests/, and
--     the instructions their bodies place, must be INLINED exactly, so the
--     code's growth can't creep unseen; a program whose first line is
--     `// inlined: <sites> sites, <instructions> instructions` is held to
--     its own count too;
--   - the loops x86/roc/Versioning.roc places twice across x86/tests/, and
--     the instructions their fast copies hold, must be VERSIONED exactly; a
--     program whose first line is `// versioned: <loops> loops,
--     <instructions> instructions` is held to its own count too;
--   - each of them, and each race below, must have its post-passes run with
--     the runtime's done once, when js-x86 was built (`js-x86 "<program>"
--     posts` says `posts: beside`; x86/roc/RuntimePosts.roc), so a change
--     that sends programs back to passing the whole runtime is seen;
--   - each program in x86/tests/refused/ names in its first line what it must
--     come to: `// refused: <text>`, a line js-x86 prints as it exits 1
--     without writing an executable, or `// stops: <text>`, a line the
--     executable it writes prints as it exits 1 (a number console.log can't
--     write yet), where node would print the number;
--   - each race of RACES (a program outside x86/tests/, too long a run at
--     its own size) is compiled and run at a small size, a copy with its
--     `const` line set written under the build mount, and held to node's
--     run of the copy the same way;
--   - each program of the interpreter's corpus, js/tests/, is compiled and
--     run the same way, and the ones that print what node prints must be
--     exactly those x86/corpus.txt lists, one a line: a program that stops
--     matching fails, and so does one that starts to, until the list (and
--     the commit that moves it) says so; and four of them are held to
--     their `heapstat` lines too (HEAP_HELD, below).
-- Each executable runs with `heapwalk` (HEAP_WALK, below), which checks every
-- block's header in its heap at its exit and at a stop, and again with
-- `gcalways` (TORTURE, below), the torture tier: a collection at every
-- allocation, each followed by the walk, so a root the collector misses or a
-- pointer its trace skips frees a block still in use, and the output stops
-- being node's. A program of TORTURE_SAMPLED runs with `gcsample` there
-- instead: a collection each time 64 KiB more of the heap are taken.
-- Each program is compiled once more in js-x86's `guardsflip` mode (FLIP,
-- below), the side exits' torture tier: every side exit of a versioned
-- loop's fast copy is also taken at every eighth of its tests, so the exits
-- into the generic copy run, and the executable, run with `heapwalk`, must
-- print node's lines too. A program whose flipped executable is its own,
-- byte for byte (it has no side exit), isn't run again.
-- Nothing is skipped: the run fails unless every program passes, and a
-- folder with no program in it fails too.
--
--   shale x86/programs.shale corpus=report
--
-- prints each corpus program's verdict and the reasons the rest fail,
-- grouped, and holds nothing.

use("./executables.shale")

const WHO = "x86/programs.shale"
const CORPUS = "x86/corpus.txt"
const REPORT = arg("corpus", "held") == "report"
-- The sites and instructions inlined across x86/tests/: a commit that moves
-- it says why.
const INLINED = "inlined: 47 sites, 683 instructions"
-- The loops versioned across x86/tests/: a commit that moves it says why.
const VERSIONED = "versioned: 23 loops, 618 instructions"
-- Every executable here runs with this first argument: it walks the heap at
-- its exit and at a stop and checks every block's header, so a header an
-- allocation wrote wrong stops the program, and its output can't be node's.
const HEAP_WALK = "heapwalk"
-- And again with this one: the collector runs at every allocation, and the
-- heap is walked after each collection.
const TORTURE = "gcalways"
-- The programs too big for it, which run with SAMPLED instead: a collection
-- at each of join.js's 620,000 allocations, over a heap of 335 pages, takes
-- minutes, and the SAT race's 270,000 at its small size, over 329 pages,
-- run past the timeout.
const SAMPLED = "gcsample"
-- And each program compiled with its side exits taken often, held to node
-- with HEAP_WALK; `flipped.count` counts those whose bytes differ.
const FLIP = "guardsflip"
const flipped = {count = 0}
const TORTURE_SAMPLED = {"x86/tests/join.js", "x86/satrace/sat.js"}
-- The heapstat lines of four corpus programs that make garbage, held
-- exactly: what each allocates, collects and keeps live to its exit
-- (x86/COLLECTOR.md, "Lane 3", reads them beside the interpreter's). A
-- commit that moves one says why.
const HEAP_HELD = {
  ["33-string-append.js"] = "heap: 55 allocations, 0 collections, 4 pages at most; live at the exit: 13 blocks, 296 bytes asked, 464 bytes in blocks, 3 pages",
  ["55-garbage.js"] = "heap: 9073 allocations, 0 collections, 17 pages at most; live at the exit: 74 blocks, 4424 bytes asked, 5824 bytes in blocks, 6 pages",
  ["57-map-set-churn.js"] = "heap: 40545 allocations, 0 collections, 57 pages at most; live at the exit: 56 blocks, 334024 bytes asked, 535552 bytes in blocks, 17 pages",
  ["60-many-instances.js"] = "heap: 14160 allocations, 0 collections, 28 pages at most; live at the exit: 191 blocks, 16008 bytes asked, 23840 bytes in blocks, 11 pages",
}
-- The races held here, each at a small size: its file, and the `const` line
-- the copy sets. The SAT race's small workload restarts and reduces once
-- (hole7), so its executable runs every part of the solver, in about 2 s.
const RACES = {
  {path = "x86/satrace/sat.js", name = "WORKLOAD", value = "\"small\""},
}

function js_files(dir)
  local out = {}
  for name in ls(dir) do
    if ends_with(name, ".js") then push(out, dir .. "/" .. name) end
  end
  sort(out)
  if #out == 0 then fail(WHO .. ": " .. dir .. " holds no program") end
  return out
end

-- The program's executable's name under the build mount: its folder's name
-- and its own, so two folders' programs never share one.
function executable_path(dir, js_path)
  return dir .. "/" .. re_replace(re_replace(js_path, "^x86/", ""), "[/.]", "-")
end

-- Why the program at `js_path` failed, or nil. `copy`, when given, is the
-- `{path, text}` of the copy to compile and to run under node in its place
-- (a race's, at its small size).
function held_to_node(exe, dir, js_path, copy?)
  local path = executable_path(dir, js_path)
  local text = nil
  local node_path = js_path
  if copy == nil then text = read(js_path) else
    text = copy.text
    node_path = copy.path
  end
  local made = driver_run(exe, text)
  if made.code ~= 0 then return "js-x86 exited " .. made.code .. ": " .. trim(made.out) end
  replace(path, bytes_of_hex(WHO, made.out))
  must(run({"chmod", "755", real(path)}, {timeout_ms = 10000, whole = 4000}))
  local r = executable_run(path, HEAP_WALK)
  local n = node_run(node_path)
  if n.code ~= 0 then return "node exited " .. n.code .. ": " .. trim(n.out) end
  if r.ended ~= "exit" or r.code ~= 0 then return "the executable ended " .. r.ended .. " " .. r.code .. ": " .. trim(r.out) end
  if r.out ~= n.out then return "it printed " .. json_write(r.out) .. ", node " .. json_write(n.out) end
  local mode = TORTURE
  if has_item(TORTURE_SAMPLED, js_path) then mode = SAMPLED end
  local t = executable_run(path, mode)
  if t.ended ~= "exit" or t.code ~= 0 then return "with " .. mode .. ", the executable ended " .. t.ended .. " " .. t.code .. ": " .. trim(t.out) end
  if t.out ~= n.out then return "with " .. mode .. ", it printed " .. json_write(t.out) .. ", node " .. json_write(n.out) end
  local flip = driver_run(exe, text, FLIP)
  if flip.code ~= 0 then return "js-x86 " .. FLIP .. " exited " .. flip.code .. ": " .. trim(flip.out) end
  if flip.out ~= made.out then
    flipped.count = flipped.count + 1
    local flip_path = path .. "-" .. FLIP
    replace(flip_path, bytes_of_hex(WHO, flip.out))
    must(run({"chmod", "755", real(flip_path)}, {timeout_ms = 10000, whole = 4000}))
    local f = executable_run(flip_path, HEAP_WALK)
    if f.ended ~= "exit" or f.code ~= 0 then return "with " .. FLIP .. ", the executable ended " .. f.ended .. " " .. f.code .. ": " .. trim(f.out) end
    if f.out ~= n.out then return "with " .. FLIP .. ", it printed " .. json_write(f.out) .. ", node " .. json_write(n.out) end
  end
  return nil
end

-- What the driver says it inlined in the program at `js_path`: `{sites,
-- instructions}`, and why it differs from the count the program's first line holds,
-- or nil.
function inlined_count(exe, js_path)
  local said = trim(driver_run(exe, read(js_path), "inlined").out)
  local m = re_find(said, "^inlined: ([0-9]+) sites, ([0-9]+) instructions$")
  if m == nil then return {sites = 0, instructions = 0, why = "js-x86 inlined said " .. json_write(said)} end
  local counted = {sites = tonumber(m.groups[1]), instructions = tonumber(m.groups[2])}
  local held = re_find(lines(read(js_path))[1], "^// (inlined: .+)$")
  if held ~= nil and held.group ~= said then counted.why = "it inlined " .. json_write(said) .. ", its first line holds " .. json_write(held.group) end
  return counted
end

-- What the driver says it versioned in the program at `js_path`: `{loops,
-- instructions}`, and why it differs from the count the program's first
-- line holds, or nil.
function versioned_count(exe, js_path)
  local said = trim(driver_run(exe, read(js_path), "versioned").out)
  local m = re_find(said, "^versioned: ([0-9]+) loops, ([0-9]+) instructions$")
  if m == nil then return {loops = 0, instructions = 0, why = "js-x86 versioned said " .. json_write(said)} end
  local counted = {loops = tonumber(m.groups[1]), instructions = tonumber(m.groups[2])}
  local held = re_find(lines(read(js_path))[1], "^// (versioned: .+)$")
  if held ~= nil and held.group ~= said then counted.why = "it versioned " .. json_write(said) .. ", its first line holds " .. json_write(held.group) end
  return counted
end

-- Why the program `text` had the whole runtime passed with it, not the
-- runtime's post-passes done once (RuntimePosts), or nil.
function posts_why(exe, text)
  local said = trim(driver_run(exe, text, "posts").out)
  if starts_with(said, "posts: beside (") then return nil end
  return "js-x86 posts said " .. json_write(said) .. ", not \"posts: beside (...)\""
end

-- Why the refused program at `js_path` failed, or nil.
function held_to_refusal(exe, dir, js_path)
  local first = lines(read(js_path))[1]
  local refused = re_find(first, "^// refused: (.+)$")
  local stops = re_find(first, "^// stops: (.+)$")
  local made = driver_run(exe, read(js_path))
  if refused ~= nil then
    if made.code ~= 1 then return "js-x86 exited " .. made.code .. ", not 1" end
    local said = trim(made.out)
    if not starts_with(said, "js-x86: refused: ") or not contains(said, refused.group) then return "js-x86 said " .. json_write(said) .. ", not a refusal holding " .. json_write(refused.group) end
    return nil
  end
  if stops == nil then return "its first line is neither `// refused: <text>` nor `// stops: <text>`" end
  if made.code ~= 0 then return "js-x86 exited " .. made.code .. ": " .. trim(made.out) end
  local path = executable_path(dir, js_path)
  replace(path, bytes_of_hex(WHO, made.out))
  must(run({"chmod", "755", real(path)}, {timeout_ms = 10000, whole = 4000}))
  local r = executable_run(path, HEAP_WALK)
  if r.ended ~= "exit" or r.code ~= 1 then return "the executable ended " .. r.ended .. " " .. r.code .. ", not exit 1" end
  local said = lines(trim(r.out))
  if #said == 0 or said[#said] ~= stops.group then return "the executable's last line is " .. json_write(trim(r.out)) .. ", not " .. json_write(stops.group) end
  local t = executable_run(path, TORTURE)
  if t.ended ~= r.ended or t.code ~= r.code or t.out ~= r.out then return "with " .. TORTURE .. ", the executable ended " .. t.ended .. " " .. t.code .. ": " .. json_write(trim(t.out)) end
  return nil
end

-- The reason a corpus program fails, with the function and the instruction
-- taken out, so programs that fail alike group.
function reason_group(why)
  local r = re_replace(why, "^js-x86 exited 1: js-x86: refused: ", "refused: ")
  r = re_replace(r, "^refused: (the program|the function `[^`]*`)(, instruction [0-9]+)?: ", "refused: ")
  r = re_replace(r, "^js-x86 exited 1: js-x86: ", "front end: ")
  if starts_with(r, "node exited ") then r = "node exits nonzero (an error the program doesn't catch)" end
  if starts_with(r, "the executable ended exit 1: ") then
    local said = lines(sub(r, #"the executable ended exit 1: " + 1))
    r = "stops: " .. said[#said]
  end
  if starts_with(r, "it printed ") then r = "prints otherwise than node" end
  return r
end

-- The corpus's verdicts against CORPUS: a list of what is wrong, empty when
-- the programs that match node are those it lists.
function corpus_check(exe, dir)
  local listed = {}
  for l in lines(read(CORPUS)) do
    if trim(l) ~= "" and not starts_with(l, "#") then push(listed, trim(l)) end
  end
  local listed_set = set_of(listed)
  local wrong = {}
  local matched = {}
  local groups = {}
  local names = {}
  local all = js_files("js/tests")
  for p in all do
    local why = held_to_node(exe, dir, p)
    yield()
    local name = basename(p)
    if why == nil and has_key(HEAP_HELD, name) then
      local s = lines(trim(executable_run(executable_path(dir, p), "heapstat").out))
      if s[#s] ~= HEAP_HELD[name] then why = "its heapstat line is " .. json_write(s[#s]) .. ", HEAP_HELD holds " .. json_write(HEAP_HELD[name]) end
    end
    if why == nil then
      push(matched, name)
      if not has_key(listed_set, name) then push(wrong, p .. ": it matches node, and " .. CORPUS .. " doesn't list it") end
    else
      local g = reason_group(why)
      push_at(groups, g, name)
      if has_key(listed_set, name) then push(wrong, p .. ": " .. why) end
    end
  end
  for name in listed do
    if not exists("js/tests/" .. name) then push(wrong, CORPUS .. " lists " .. name .. ", which js/tests/ doesn't hold") end
  end
  if REPORT then
    print("corpus: " .. #matched .. " of " .. #all .. " match node: " .. join(matched, " "))
    local rows = {}
    for g in keys(groups) do push(rows, {n = #groups[g], g = g}) end
    sort(rows, "n", "desc")
    for row in rows do print(row.n .. "  " .. row.g .. ": " .. join(groups[row.g], " ")) end
  end
  return {wrong = wrong, matched = #matched, all = #all}
end

function main()
  local exe = built_roc(WHO, "x86/roc/JsToX86.roc", "js-x86", "dev")
  local dir = executables_dir()
  local wrong = {}
  local held = js_files("x86/tests")
  local refused = js_files("x86/tests/refused")
  local sites = 0
  local instructions = 0
  local loops = 0
  local copied = 0
  for p in held do
    local why = held_to_node(exe, dir, p)
    if why ~= nil then push(wrong, p .. ": " .. why) end
    local counted = inlined_count(exe, p)
    if has_key(counted, "why") then push(wrong, p .. ": " .. counted.why) end
    local posts = posts_why(exe, read(p))
    if posts ~= nil then push(wrong, p .. ": " .. posts) end
    sites = sites + counted.sites
    instructions = instructions + counted.instructions
    local versions = versioned_count(exe, p)
    if has_key(versions, "why") then push(wrong, p .. ": " .. versions.why) end
    loops = loops + versions.loops
    copied = copied + versions.instructions
    yield()
  end
  local inlined = "inlined: " .. sites .. " sites, " .. instructions .. " instructions"
  if inlined ~= INLINED then push(wrong, "x86/tests/: " .. inlined .. ", and INLINED holds " .. json_write(INLINED)) end
  local versioned = "versioned: " .. loops .. " loops, " .. copied .. " instructions"
  if versioned ~= VERSIONED then push(wrong, "x86/tests/: " .. versioned .. ", and VERSIONED holds " .. json_write(VERSIONED)) end
  for p in refused do
    local why = held_to_refusal(exe, dir, p)
    if why ~= nil then push(wrong, p .. ": " .. why) end
    yield()
  end
  for race in RACES do
    local pattern = "\nconst " .. race.name .. " = [^;\n]+;"
    local text = read(race.path)
    if re_find(text, pattern) == nil then
      push(wrong, race.path .. ": no line `const " .. race.name .. " = ...;` to set")
    else
      local copy = {path = executable_path(dir, race.path) .. "-small.js", text = re_replace(text, pattern, "\nconst " .. race.name .. " = " .. race.value .. ";")}
      replace(copy.path, copy.text)
      local why = held_to_node(exe, dir, race.path, copy)
      if why ~= nil then push(wrong, race.path .. " (" .. race.name .. " " .. race.value .. "): " .. why) end
      local posts = posts_why(exe, copy.text)
      if posts ~= nil then push(wrong, race.path .. " (" .. race.name .. " " .. race.value .. "): " .. posts) end
    end
    yield()
  end
  if #wrong > 0 then fail(WHO .. ": " .. #wrong .. " of " .. (#held + #refused + #RACES) .. " programs failed:\n" .. join(wrong, "\n")) end
  local corpus = corpus_check(exe, dir)
  if #corpus.wrong > 0 and not REPORT then fail(WHO .. ": the corpus differs from " .. CORPUS .. ":\n" .. join(corpus.wrong, "\n")) end
  print("x86/programs: " .. inlined .. " across x86/tests/")
  print("x86/programs: " .. versioned .. " across x86/tests/")
  print("x86/programs: " .. TORTURE .. " held every program to node too, " .. SAMPLED .. " in its place for " .. join(TORTURE_SAMPLED, ", "))
  print("x86/programs: " .. FLIP .. " held the " .. flipped.count .. " programs with side exits to node too")
  print("x86/programs: " .. #held .. " programs and " .. #RACES .. " race at a small size printed what node prints, " .. #refused .. " came to their refusals, and " .. corpus.matched .. " of the corpus's " .. corpus.all .. " match node, held exactly to " .. CORPUS)
end

main()
