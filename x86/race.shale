-- budget: steps=50000000
-- x86/race.shale: the fib race, x86/race/fib_race.js, compiled by js-x86
-- against node and against x86/race/fibonacci_race.roc, its line-for-line Roc
-- port, built by Roc's release build (LLVM, --opt=speed, from the shared
-- cache). Each contestant computes the same F(N) and prints it; the
-- race is the wall time of each one's whole run. check.shale does not run
-- it: the full size takes minutes, and its numbers are timings. From the
-- repository's root:
--
--   shale x86/race.shale               # F(N) for the file's own N, about a minute compiled
--   shale x86/race.shale size=small    # F(SMALL_N), about a second compiled, for tuning
--   shale x86/race.shale n=200000      # any N of at least 1000
--   shale x86/race.shale size=small runs=5   # five runs of each in turn, and the medians
--
-- `n=` (or `size=small`) writes a copy of fib_race.js with its `const N`
-- line changed, under the build mount, and both contestants run the copy;
-- unset, the copy is the file as written. (It sits beside x86/bench.shale,
-- not in x86/race/, since a library is named only beside a script's own
-- file or below it, and both name x86/executables.shale.)
--
-- It builds js-x86 on the dev backend (the executable's bytes are the same
-- whatever the driver's build), writes the race's executable under the
-- build mount, builds fibonacci_race.roc's release executable, then runs the
-- compiled executable, `node fib_race.js` and `fib-race-roc N` (Roc's N is
-- its argument, so nothing of the race is known when Roc compiles it),
-- niced, one after the other, never at once (the box has 2 cores), each timed from
-- outside by its wall clock, start to exit. Each contestant's whole output
-- is checked: for an N in HASHES, its sha256 must be the one stored there
-- (BigInt's output for that N, computed once with x86/race/verify.js);
-- for any other N, it must be verify.js's output exactly. Each
-- contestant's line says its wall time and whether its output matched;
-- node's line adds the ratio of the compiled time to node's, and Roc's the
-- ratio of the compiled time to Roc's.

use("./executables.shale")

const WHO = "x86/race.shale"
const RACE = "x86/race/fib_race.js"
const ROC_RACE = "x86/race/fibonacci_race.roc"
const WANT_ROC_RACE = "x86: fibonacci_race.roc's release executable, a contestant"
const VERIFY = "x86/race/verify.js"
const WANT_VERIFY = "node: verify.js, BigInt's answer for the race"
const SMALL_N = 100000
const TIMEOUT_MS = 600000

-- sha256 of verify.js's whole output for an N, so the full size needs no
-- BigInt run: `node x86/race/verify.js N | sha256sum`.
const HASHES = {["740000"] = "d5f4013933480b5983a65518c13f471105157327e2fba2f0ee504c2384004f9e"}

function sha256(text)
  local r = must(run({"sha256sum"}, {stdin = text, timeout_ms = 60000, tail = 2}))
  return sub(trim(r.out), 1, 64)
end

-- A contestant's run: its wall time and its whole output.
function raced(who, argv, want)
  local r = run(argv, {timeout_ms = TIMEOUT_MS, whole = 4000000, want = want, nice = 19})
  if r.ended ~= "exit" or r.code ~= 0 then fail(WHO .. ": " .. who .. " ended " .. r.ended .. " " .. get(r, "code", -1) .. ": " .. sub(r.out, 1, 2000)) end
  return {who = who, out = r.out, ms = r.ms}
end

-- What an output must be for `n`: a hash, or verify.js's output.
function wanted(n)
  local key = "" .. n
  if has_key(HASHES, key) then return {hash = HASHES[key]} end
  local v = run({"node", real(VERIFY), key}, {timeout_ms = TIMEOUT_MS, whole = 4000000, want = WANT_VERIFY, nice = 19})
  if v.code ~= 0 then fail(WHO .. ": verify.js exited " .. get(v, "code", -1) .. ": " .. sub(v.out, 1, 2000)) end
  return {out = v.out}
end

-- Whether a contestant's output is what `want` says, and where it isn't.
function checked(c, want)
  if has_key(want, "hash") then
    if sha256(c.out) == want.hash then return "matched (sha256)" end
    return "WRONG: sha256 " .. sub(sha256(c.out), 1, 16) .. ", stored " .. sub(want.hash, 1, 16) .. "; first line " .. sub(lines(c.out)[1], 1, 80)
  end
  if c.out == want.out then return "matched (verify.js)" end
  local got = lines(c.out)
  local exp = lines(want.out)
  for i = 1, #exp do
    if i > #got or got[i] ~= exp[i] then
      local line = "(none)"
      if i <= #got then line = got[i] end
      return "WRONG at line " .. i .. ": " .. sub(line, 1, 80) .. ", BigInt's " .. sub(exp[i], 1, 80)
    end
  end
  return "WRONG: " .. #got .. " lines, verify.js " .. #exp
end

-- Milliseconds as seconds, to the hundredth.
function secs(ms)
  local hundredths = (ms + 5) // 10
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac .. " s"
end

-- a / b to the hundredth.
function ratio(a, b)
  local hundredths = (a * 100 + b // 2) // b
  local frac = "" .. hundredths % 100
  if #frac < 2 then frac = "0" .. frac end
  return (hundredths // 100) .. "." .. frac
end

function median(list)
  local sorted = {}
  for x in list do push(sorted, x) end
  sort(sorted)
  return sorted[(#sorted + 1) // 2]
end

-- The race's text with N set to `n`, and the N it holds.
function race_text(n)
  local text = read(RACE)
  local m = re_find(text, "\nconst N = ([0-9]+);")
  if m == nil then fail(WHO .. ": " .. RACE .. " has no line `const N = <digits>;` to set N in") end
  if n < 0 then return {text = text, n = tonumber(m.group)} end
  return {text = re_replace(text, "\nconst N = [0-9]+;", "\nconst N = " .. n .. ";"), n = n}
end

function main()
  local size = arg("size", "full")
  local n = arg("n", -1)
  local runs = arg("runs", 1)
  if size == "small" then
    if n >= 0 then fail(WHO .. ": give n= or size=small, not both") end
    n = SMALL_N
  elseif size ~= "full" then
    fail(WHO .. ": size=" .. size .. " is neither full nor small")
  end
  if n >= 0 and n < 1000 then fail(WHO .. ": n=" .. n .. " is under 1000, the F(1000) the race checks on the way") end
  if runs < 1 then fail(WHO .. ": runs=" .. runs .. " is under 1") end
  local race = race_text(n)
  local exe = built_roc(WHO, "x86/roc/JsToX86.roc", "js-x86", "dev")
  local dir = executables_dir()
  local path = dir .. "/race-fib_race"
  local copy = dir .. "/race-fib_race.js"
  replace(copy, race.text)
  local bytes = written_executable(WHO, exe, race.text, path)
  local roc_exe = built_roc(WHO, ROC_RACE, "fib-race-roc", "speed")
  local want = wanted(race.n)
  local node = run({"node", "--version"}, {timeout_ms = 10000, whole = 1000, want = WANT_NODE})
  local uptime = trim(must(run({"uptime"}, {timeout_ms = 10000, whole = 1000})).out)
  print("F(" .. race.n .. "); the race's executable: " .. bytes .. " bytes; node " .. trim(node.out) .. "; " .. uptime)
  local times = {compiled = {}, node = {}, roc = {}}
  for i = 1, runs do
    local compiled = raced("compiled", {real(path)}, WANT_BINARY)
    local js = raced("node", {"node", real(copy)}, WANT_NODE)
    local roc = raced("roc", {roc_exe, "" .. race.n}, WANT_ROC_RACE)
    push(times.compiled, compiled.ms)
    push(times.node, js.ms)
    push(times.roc, roc.ms)
    print("compiled: " .. secs(compiled.ms) .. ", " .. checked(compiled, want))
    print("node: " .. secs(js.ms) .. ", " .. checked(js, want) .. "; compiled/node " .. ratio(compiled.ms, js.ms))
    print("roc: " .. secs(roc.ms) .. ", " .. checked(roc, want) .. "; compiled/roc " .. ratio(compiled.ms, roc.ms))
  end
  if runs > 1 then
    local after = trim(must(run({"uptime"}, {timeout_ms = 10000, whole = 1000})).out)
    local c = median(times.compiled)
    local j = median(times.node)
    local k = median(times.roc)
    print("medians of " .. runs .. ": compiled " .. secs(c) .. ", node " .. secs(j) .. ", roc " .. secs(k) .. "; compiled/node " .. ratio(c, j) .. ", compiled/roc " .. ratio(c, k) .. "; " .. after)
  end
end

main()
